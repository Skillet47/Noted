@page "/settings"
@using BusinessLogic.Core
@using Noted.Services
@inject ThemeService ThemeService
@inject StorageService StorageService

<div class="settings-container">
    <header class="settings-header">
        <div class="header-icon"><span class="bi bi-gear" aria-hidden="true"></span></div>
        <div class="header-text">
            <h1>Settings</h1>
            <p class="header-subtitle">Customize your Noted experience</p>
        </div>
    </header>

    @* Storage Location Section *@
    <section class="settings-section">
        <div class="section-header">
            <span class="section-icon bi bi-folder2" aria-hidden="true"></span>
            <div>
                <h2>Storage Location</h2>
                <p class="section-description">Choose where your notes are saved</p>
            </div>
        </div>

        <div class="storage-location-container">
            @* Display current storage path *@
            <div class="current-location">
                <label class="form-label">Current Location</label>
                <div class="location-display">
                    <span class="location-path">@StorageService.CurrentStorageLocation</span>
                    @if (StorageService.IsDefaultLocation)
                    {
                        <span class="default-badge">Default</span>
                    }
                </div>
            </div>

            @* Input for new storage path *@
            <div class="location-input-container">
                <label class="form-label">New Location</label>
                <div class="input-with-button">
                    <input type="text" 
                           @bind="newLocationPath" 
                           @bind:event="oninput"
                           placeholder="Enter folder path..." 
                           class="form-control location-input" />
                    <button class="btn btn-primary" @onclick="SetNewLocation" disabled="@string.IsNullOrWhiteSpace(newLocationPath)">
                        Set Location
                    </button>
                </div>
            </div>

            @* Reset button - only shown when not using default location *@
            <div class="storage-actions">
                @if (!StorageService.IsDefaultLocation)
                {
                    <button class="btn btn-secondary" @onclick="ResetToDefault">
                        Reset to Default
                    </button>
                }
            </div>

            @* Status message for user feedback *@
            @if (!string.IsNullOrEmpty(statusMessage))
            {
                <div class="status-message @(isError ? "error" : "success")">
                    @statusMessage
                </div>
            }

            <p class="storage-note">
                <strong>Note:</strong> Changing the storage location will not move existing notes. 
                You'll need to manually move your note files to the new location. Restart the app after changing the location.
            </p>
        </div>
    </section>

    @* Preview Size Section *@
    <section class="settings-section">
        <div class="section-header">
            <span class="section-icon bi bi-aspect-ratio" aria-hidden="true"></span>
            <div>
                <h2>Note Preview Size</h2>
                <p class="section-description">Choose how much content to show in note previews</p>
            </div>
        </div>

        <div class="preview-size-grid">
            @foreach (var size in Enum.GetValues<PreviewSize>())
            {
                <button class="preview-size-card @(StorageService.PreviewSize == size ? "active" : "")"
                        @onclick="() => SelectPreviewSize(size)">
                    <div class="preview-size-demo @size.ToString().ToLowerInvariant()">
                        <div class="demo-title"></div>
                        @if (size != PreviewSize.None)
                        {
                            <div class="demo-content"></div>
                        }
                    </div>
                    <div class="preview-size-info">
                        <h4>@GetPreviewSizeDisplayName(size)</h4>
                        <p>@GetPreviewSizeDescription(size)</p>
                    </div>
                    @if (StorageService.PreviewSize == size)
                    {
                        <span class="preview-size-check bi bi-check-lg" aria-hidden="true"></span>
                    }
                </button>
            }
        </div>
    </section>

    @* Theme Selection Section *@
    <section class="settings-section">
        <div class="section-header">
            <span class="section-icon bi bi-palette" aria-hidden="true"></span>
            <div>
                <h2>Appearance</h2>
                <p class="section-description">Choose your preferred color theme</p>
            </div>
        </div>

        @* Theme selection grid - displays all available themes as clickable cards *@
        <div class="theme-grid">
            @foreach (var theme in ThemeService.AvailableThemes)
            {
                <button class="theme-card @(ThemeService.CurrentTheme == theme.Id ? "active" : "")"
                        @onclick="() => SelectTheme(theme.Id)">
                    @* Visual preview of the theme colors *@
                    <div class="theme-preview @theme.Id">
                        <div class="preview-sidebar"></div>
                        <div class="preview-content">
                            <div class="preview-card"></div>
                            <div class="preview-card"></div>
                        </div>
                    </div>
                    <div class="theme-info">
                        <h4>@theme.Name</h4>
                        <p>@theme.Description</p>
                    </div>
                    @* Checkmark indicator for selected theme *@
                    @if (ThemeService.CurrentTheme == theme.Id)
                    {
                        <span class="theme-check bi bi-check-lg" aria-hidden="true"></span>
                    }
                </button>
            }
        </div>
    </section>
</div>

@code {
    // Form state for storage location input
    private string newLocationPath = string.Empty;
    private string statusMessage = string.Empty;
    private bool isError = false;

    /// <summary>
    /// Validates and sets a new storage location for notes.
    /// </summary>
    private void SetNewLocation()
    {
        if (string.IsNullOrWhiteSpace(newLocationPath))
        {
            statusMessage = "Please enter a valid folder path.";
            isError = true;
            return;
        }

        try
        {
            if (StorageService.IsValidPath(newLocationPath))
            {
                var fullPath = Path.GetFullPath(newLocationPath);
                StorageService.CurrentStorageLocation = fullPath;
                statusMessage = "Storage location updated successfully. Restart the app to apply changes.";
                isError = false;
                newLocationPath = string.Empty;
            }
            else
            {
                statusMessage = "Invalid folder path. Please enter a valid path.";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error setting location: {ex.Message}";
            isError = true;
        }
    }

    /// <summary>
    /// Resets the storage location to the default app data directory.
    /// </summary>
    private void ResetToDefault()
    {
        StorageService.ResetToDefault();
        statusMessage = "Storage location reset to default. Restart the app to apply changes.";
        isError = false;
        newLocationPath = string.Empty;
    }

    /// <summary>
    /// Changes the application theme. Takes effect immediately.
    /// </summary>
    private void SelectTheme(string themeId)
    {
        ThemeService.CurrentTheme = themeId;
    }

    /// <summary>
    /// Changes the preview size setting. Takes effect immediately.
    /// </summary>
    private void SelectPreviewSize(PreviewSize size)
    {
        StorageService.PreviewSize = size;
    }

    /// <summary>
    /// Gets a user-friendly display name for a preview size.
    /// </summary>
    private static string GetPreviewSizeDisplayName(PreviewSize size) => size switch
    {
        PreviewSize.None => "None",
        PreviewSize.Small => "Small",
        PreviewSize.Medium => "Medium",
        PreviewSize.Large => "Large",
        _ => size.ToString()
    };

    /// <summary>
    /// Gets a description for each preview size option.
    /// </summary>
    private static string GetPreviewSizeDescription(PreviewSize size) => size switch
    {
        PreviewSize.None => "Show only title and metadata",
        PreviewSize.Small => "Brief content snippet",
        PreviewSize.Medium => "Moderate preview length",
        PreviewSize.Large => "Extended content preview",
        _ => ""
    };
}
