@page "/settings"
@using Noted.Services
@inject ThemeService ThemeService
@inject StorageService StorageService
@inject IFolderPickerService FolderPickerService

<div class="settings-container">
    <header class="settings-header">
        <div class="header-icon"><span class="bi bi-gear" aria-hidden="true"></span></div>
        <div class="header-text">
            <h1>Settings</h1>
            <p class="header-subtitle">Customize your Noted experience</p>
        </div>
    </header>

    @* Storage Location Section *@
    <section class="settings-section">
        <div class="section-header">
            <span class="section-icon bi bi-folder2" aria-hidden="true"></span>
            <div>
                <h2>Storage Location</h2>
                <p class="section-description">Choose where your notes are saved</p>
            </div>
        </div>

        <div class="storage-location-container">

            @* Current location — shows a friendly name, not the raw path *@
            <div class="current-location">
                <label class="form-label">Current Location</label>
                <div class="location-display">
                    <span class="bi bi-folder-fill location-icon" aria-hidden="true"></span>
                    <span class="location-name">@GetFriendlyLocationName()</span>
                    @if (StorageService.IsDefaultLocation)
                    {
                        <span class="default-badge">Default</span>
                    }
                </div>
            </div>

            @* Safety warning *@
            <div class="warning-callout">
                <span class="bi bi-exclamation-triangle-fill warning-callout-icon" aria-hidden="true"></span>
                <div class="warning-callout-body">
                    <strong>Notes are not moved automatically</strong>
                    <p>Changing the storage location won't affect your existing notes. You'll need to move your note files to the new folder manually, then restart the app for the change to take effect.</p>
                </div>
            </div>

            @* Action buttons *@
            <div class="storage-actions">
                <button class="btn btn-primary browse-btn @(_isBrowsing ? "loading" : "")"
                        @onclick="BrowseForFolder"
                        disabled="@_isBrowsing">
                    @if (_isBrowsing)
                    {
                        <span class="bi bi-arrow-repeat spin" aria-hidden="true"></span>
                        <span>Opening…</span>
                    }
                    else
                    {
                        <span class="bi bi-folder2-open" aria-hidden="true"></span>
                        <span>Browse…</span>
                    }
                </button>

                @if (!StorageService.IsDefaultLocation)
                {
                    <button class="btn btn-danger-soft" @onclick="ResetToDefault">
                        <span class="bi bi-arrow-counterclockwise" aria-hidden="true"></span>
                        Reset to Default
                    </button>
                }
            </div>

            @* Status feedback with icon *@
            @if (!string.IsNullOrEmpty(_statusMessage))
            {
                <div class="status-message @(_isError ? "error" : "success")">
                    <span class="bi @(_isError ? "bi-x-circle-fill" : "bi-check-circle-fill") status-icon" aria-hidden="true"></span>
                    @_statusMessage
                </div>
            }
        </div>
    </section>

    @* UI Scaling Section *@
    <section class="settings-section">
        <div class="section-header">
            <span class="section-icon bi bi-aspect-ratio" aria-hidden="true"></span>
            <div>
                <h2>UI Scaling</h2>
                <p class="section-description">Adjust overall app sizing for comfort and accessibility</p>
            </div>
        </div>

        <div class="ui-scale-grid">
            @foreach (var scale in ThemeService.AvailableUiScales)
            {
                <button class="ui-scale-card @(Math.Abs(ThemeService.UiScale - scale.Scale) < 0.001 ? "active" : "")"
                        @onclick="() => SelectUiScale(scale.Scale)">
                    <div class="ui-scale-demo">
                        <div class="demo-ribbon"></div>
                        <div class="demo-sidebar"></div>
                        <div class="demo-content">
                            <div class="demo-line"></div>
                            <div class="demo-line short"></div>
                        </div>
                    </div>
                    <div class="ui-scale-info">
                        <h4>@scale.Name (@((int)(scale.Scale * 100))%)</h4>
                        <p>@scale.Description</p>
                    </div>
                    @if (Math.Abs(ThemeService.UiScale - scale.Scale) < 0.001)
                    {
                        <span class="ui-scale-check bi bi-check-lg" aria-hidden="true"></span>
                    }
                </button>
            }
        </div>
    </section>

    @* Theme Selection Section *@
    <section class="settings-section">
        <div class="section-header">
            <span class="section-icon bi bi-palette" aria-hidden="true"></span>
            <div>
                <h2>Appearance</h2>
                <p class="section-description">Choose your preferred color theme</p>
            </div>
        </div>

        @* Theme selection grid - displays all available themes as clickable cards *@
        <div class="theme-grid">
            @foreach (var theme in ThemeService.AvailableThemes)
            {
                <button class="theme-card @(ThemeService.CurrentTheme == theme.Id ? "active" : "")"
                        @onclick="() => SelectTheme(theme.Id)">
                    @* Visual preview of the theme colors *@
                    <div class="theme-preview @theme.Id">
                        <div class="preview-sidebar"></div>
                        <div class="preview-content">
                            <div class="preview-card"></div>
                            <div class="preview-card"></div>
                        </div>
                    </div>
                    <div class="theme-info">
                        <h4>@theme.Name</h4>
                        <p>@theme.Description</p>
                    </div>
                    @* Checkmark indicator for selected theme *@
                    @if (ThemeService.CurrentTheme == theme.Id)
                    {
                        <span class="theme-check bi bi-check-lg" aria-hidden="true"></span>
                    }
                </button>
            }
        </div>
    </section>
</div>

@code {
    // Storage section state
    private string _statusMessage = string.Empty;
    private bool _isError;
    private bool _isBrowsing;

    /// <summary>
    /// Returns a human-readable location name instead of the raw file path.
    /// </summary>
    private string GetFriendlyLocationName()
    {
        if (StorageService.IsDefaultLocation)
            return "App Data";

        var path = StorageService.CurrentStorageLocation;
        if (string.IsNullOrEmpty(path))
            return "Unknown";

        var folderName = Path.GetFileName(path);
        var parentName = Path.GetFileName(Path.GetDirectoryName(path) ?? string.Empty);
        return string.IsNullOrEmpty(parentName) ? folderName : $"{parentName}/{folderName}";
    }

    /// <summary>
    /// Opens a native folder picker and applies the chosen location immediately.
    /// </summary>
    private async Task BrowseForFolder()
    {
        _isBrowsing = true;
        _statusMessage = string.Empty;
        StateHasChanged();

        try
        {
            var pickedPath = await FolderPickerService.PickFolderAsync();

            if (string.IsNullOrEmpty(pickedPath))
                return; // user cancelled — no feedback needed

            if (!StorageService.IsValidPath(pickedPath))
            {
                _statusMessage = "The selected folder is not accessible. Please choose a different location.";
                _isError = true;
                return;
            }

            StorageService.CurrentStorageLocation = Path.GetFullPath(pickedPath);
            _statusMessage = "Storage location updated. Restart the app for the change to take effect.";
            _isError = false;

            // Auto-dismiss the success message after 5 seconds
            _ = Task.Delay(5000).ContinueWith(_ =>
            {
                _statusMessage = string.Empty;
                InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            _statusMessage = $"Could not set location: {ex.Message}";
            _isError = true;
        }
        finally
        {
            _isBrowsing = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Resets the storage location to the default app data directory.
    /// </summary>
    private void ResetToDefault()
    {
        StorageService.ResetToDefault();
        _statusMessage = "Storage location reset to default. Restart the app for the change to take effect.";
        _isError = false;

        _ = Task.Delay(5000).ContinueWith(_ =>
        {
            _statusMessage = string.Empty;
            InvokeAsync(StateHasChanged);
        });
    }

    /// <summary>
    /// Changes the application theme. Takes effect immediately.
    /// </summary>
    private void SelectTheme(string themeId)
    {
        ThemeService.CurrentTheme = themeId;
    }

    /// <summary>
    /// Changes the global app UI scale. Takes effect immediately.
    /// </summary>
    private void SelectUiScale(double scale)
    {
        ThemeService.UiScale = scale;
    }
}
