@page "/"
@using BusinessLogic.Core
@using BusinessLogic.Notes
@using Noted.Services
@inject NoteManagement NoteManager
@inject INotificationService NotificationService
@inject FilterService FilterService

<div class="app-container">
    <header class="app-header">
        <h1>Notes</h1>
        <button class="btn btn-primary" @onclick="OpenAddModal">+ Add Note</button>
    </header>

    <div class="filter-container">
        <input type="text" @bind="searchQuery" @bind:event="oninput" @bind:after="OnSearchQueryChanged" placeholder="Search notes..." class="form-control search-input" />
        <select @bind="filterType" @bind:after="OnFilterTypeChanged" class="form-select filter-select">
            <option value="">All Types</option>
            @foreach (var type in Enum.GetValues<NoteType>())
            {
                <option value="@type">@type</option>
            }
        </select>
        <select @bind="sortOption" @bind:after="OnSortOptionChanged" class="form-select sort-select">
            @foreach (var option in Enum.GetValues<SortOption>())
            {
                <option value="@option">@FilterService.GetSortOptionDisplayName(option)</option>
            }
        </select>
        @if (FilterService.HasActiveFilters)
        {
            <button class="btn btn-outline-secondary btn-clear-filters" @onclick="ClearFilters" title="Clear all filters">
                ✕ Clear
            </button>
        }
    </div>

    @if (FilteredNotes.Count == 0)
    {
        <p class="text-muted">@(notes.Count == 0 ? "No notes yet. Click \"Add Note\" to create your first note!" : "No notes match your search criteria.")</p>
    }
    else
    {
        <div class="notes-container">
            @foreach (var note in FilteredNotes)
            {
                <div class="note-card @GetNoteTypeClass(note.Type)">
                    <div class="note-header">
                        <h4>@note.Title</h4>
                        <span class="badge">@note.Type</span>
                    </div>
                    <p class="note-content">@note.Content</p>
                    @if (note is ReminderNote reminderNote)
                    {
                        <div class="reminder-info @(reminderNote.ReminderDateTime < DateTime.Now ? "reminder-past" : "")">
                            <span class="reminder-icon">🔔</span>
                            <span>@reminderNote.ReminderDateTime.ToString("g")</span>
                            @if (reminderNote.ReminderDateTime < DateTime.Now)
                            {
                                <span class="reminder-status">(Past)</span>
                            }
                        </div>
                    }
                    <div class="note-footer">
                        <div class="note-dates">
                            <small>Created: @note.CreatedAt.ToString("g")</small>
                            <small>Modified: @note.ModifiedAt.ToString("g")</small>
                        </div>
                        <div class="note-actions">
                            <button class="btn btn-sm btn-secondary" @onclick="() => OpenEditModal(note)">Edit</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteNote(note)">Delete</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (showModal)
{
    <div class="modal-backdrop" @onclick="CloseModal"></div>
    <div class="modal-container">
        <div class="modal-dialog">
            <div class="modal-header">
                <h5 class="modal-title">@(isEditMode ? "Edit Note" : "Add New Note")</h5>
            </div>
            <div class="modal-body">
                <input type="text" @bind="editNoteTitle" placeholder="Note title..." class="form-control mb-2" />
                <textarea @bind="editNoteContent" placeholder="Write your note here..." class="form-control mb-2" rows="3"></textarea>
                <select @bind="editNoteType" class="form-select mb-2">
                    @foreach (var type in Enum.GetValues<NoteType>())
                    {
                        <option value="@type">@type</option>
                    }
                </select>
                @if (editNoteType == NoteType.Reminder)
                {
                    <div class="reminder-datetime-container">
                        <label class="form-label">Reminder Date & Time</label>
                        <input type="datetime-local" 
                               @bind="editReminderDateTime" 
                               min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
                               class="form-control" />
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveNote">@(isEditMode ? "Save Changes" : "Add Note")</button>
            </div>
        </div>
    </div>
}

@code {
    private List<Note> notes = [];
    private string editNoteTitle = string.Empty;
    private string editNoteContent = string.Empty;
    private NoteType editNoteType = NoteType.Idea;
    private DateTime? editReminderDateTime;
    private bool showModal = false;
    private bool isEditMode = false;
    private Note? editingNote = null;
    private string searchQuery = string.Empty;
    private string filterType = string.Empty;
    private SortOption sortOption = SortOption.ModifiedNewest;

    private List<Note> FilteredNotes
    {
        get
        {
            var filtered = notes
                .Where(n => string.IsNullOrWhiteSpace(searchQuery) ||
                            n.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                            n.Content.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
                .Where(n => string.IsNullOrWhiteSpace(filterType) ||
                            n.Type.ToString() == filterType);

            filtered = sortOption switch
            {
                SortOption.ModifiedNewest => filtered.OrderByDescending(n => n.ModifiedAt),
                SortOption.ModifiedOldest => filtered.OrderBy(n => n.ModifiedAt),
                SortOption.CreatedNewest => filtered.OrderByDescending(n => n.CreatedAt),
                SortOption.CreatedOldest => filtered.OrderBy(n => n.CreatedAt),
                SortOption.TitleAZ => filtered.OrderBy(n => n.Title, StringComparer.OrdinalIgnoreCase),
                SortOption.TitleZA => filtered.OrderByDescending(n => n.Title, StringComparer.OrdinalIgnoreCase),
                _ => filtered.OrderByDescending(n => n.ModifiedAt)
            };

            return filtered.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await NotificationService.RequestPermissionAsync();
        LoadPersistedFilters();
        LoadNotes();
    }

    private void LoadPersistedFilters()
    {
        searchQuery = FilterService.SearchQuery;
        filterType = FilterService.FilterType;
        sortOption = FilterService.SortOption;
    }

    private void OnSearchQueryChanged()
    {
        FilterService.SearchQuery = searchQuery;
    }

    private void OnFilterTypeChanged()
    {
        FilterService.FilterType = filterType;
    }

    private void OnSortOptionChanged()
    {
        FilterService.SortOption = sortOption;
    }

    private void ClearFilters()
    {
        searchQuery = string.Empty;
        filterType = string.Empty;
        sortOption = SortOption.ModifiedNewest;
        FilterService.ClearFilters();
    }

    private void LoadNotes()
    {
        notes = NoteManager.RetrieveNotes().ToList();
    }

    private void OpenAddModal()
    {
        isEditMode = false;
        editingNote = null;
        ResetForm();
        showModal = true;
    }

    private void OpenEditModal(Note note)
    {
        isEditMode = true;
        editingNote = note;
        editNoteTitle = note.Title;
        editNoteContent = note.Content;
        editNoteType = note.Type;
        editReminderDateTime = note is ReminderNote r ? r.ReminderDateTime : null;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        ResetForm();
    }

    private void ResetForm()
    {
        editNoteTitle = string.Empty;
        editNoteContent = string.Empty;
        editNoteType = NoteType.Idea;
        editReminderDateTime = null;
        editingNote = null;
    }

    private async Task SaveNote()
    {
        if (string.IsNullOrWhiteSpace(editNoteTitle) || string.IsNullOrWhiteSpace(editNoteContent))
            return;

        DateTime? reminderDateTime = editNoteType == NoteType.Reminder ? editReminderDateTime : null;

        if (isEditMode && editingNote is not null)
        {
            var updatedNote = CreateNote(editNoteType, editNoteTitle, editNoteContent, editingNote.CreatedAt, DateTime.Now, reminderDateTime);

            NoteManager.UpdateNote(editingNote.Title, updatedNote);
            
            // Cancel old notification and schedule new one if needed
            await NotificationService.CancelNotificationAsync($"reminder_{editingNote.Title}");
            if (reminderDateTime.HasValue && reminderDateTime.Value > DateTime.Now)
            {
                await NotificationService.ScheduleNotificationAsync(
                    $"reminder_{editNoteTitle}",
                    $"Reminder: {editNoteTitle}",
                    editNoteContent,
                    reminderDateTime.Value);
            }
        }
        else
        {
            var note = CreateNote(editNoteType, editNoteTitle, editNoteContent, DateTime.Now, DateTime.Now, reminderDateTime);

            NoteManager.SaveNote(note);
            
            // Schedule notification for new reminder
            if (reminderDateTime.HasValue && reminderDateTime.Value > DateTime.Now)
            {
                await NotificationService.ScheduleNotificationAsync(
                    $"reminder_{editNoteTitle}",
                    $"Reminder: {editNoteTitle}",
                    editNoteContent,
                    reminderDateTime.Value);
            }
        }

        LoadNotes();
        CloseModal();
    }

    private static Note CreateNote(NoteType noteType, string title, string content, DateTime createdAt, DateTime modifiedAt, DateTime? reminderDateTime)
    {
        return noteType switch
        {
            NoteType.Reminder => new ReminderNote
            {
                Title = title,
                Content = content,
                CreatedAt = createdAt,
                ModifiedAt = modifiedAt,
                ReminderDateTime = reminderDateTime ?? DateTime.MinValue
            },
            NoteType.Task => new TaskNote
            {
                Title = title,
                Content = content,
                CreatedAt = createdAt,
                ModifiedAt = modifiedAt
            },
            NoteType.Idea => new IdeaNote
            {
                Title = title,
                Content = content,
                CreatedAt = createdAt,
                ModifiedAt = modifiedAt
            },
            _ => throw new InvalidOperationException($"Unknown note type: {noteType}")
        };
    }

    private async Task DeleteNote(Note note)
    {
        if (NoteManager.DeleteNote(note.Title))
        {
            await NotificationService.CancelNotificationAsync($"reminder_{note.Title}");
            LoadNotes();
        }
    }

    private static string GetNoteTypeClass(NoteType type) => type.ToString().ToLowerInvariant();
}
