@page "/"
@using BusinessLogic.Core
@using BusinessLogic.Notes
@using Noted.Services
@using Noted.Components.Modals
@inject NoteManagement NoteManager
@inject INotificationService NotificationService
@inject FilterService FilterService
@inject StorageService StorageService
@inject MarkdownService MarkdownService
@inject RichTextService RichTextService
@inject NavigationManager Navigation

<div class="app-container">
    @* Page header with title and add button *@
    <header class="app-header">
        <h1>Notes</h1>
        <button class="btn btn-primary" @onclick="OpenAddNote">+ Add Note</button>
    </header>

    @* Folder selection and creation controls *@
    <div class="folder-container">
        <div class="folder-select-wrapper">
            <span class="folder-icon bi bi-folder" aria-hidden="true"></span>
            <select @bind="selectedFolder" @bind:after="OnFolderChanged" class="form-select folder-select">
                <option value="">Root Folder</option>
                @foreach (var folder in folders)
                {                   
                    <option value="@folder">@folder</option>
                }
                <option value="Trash">Trash</option>
            </select>
            @foreach (var folder in folders)
            {
                <button 
                    class="btn btn-outline-danger btn-sm ms-2" 
                    style="vertical-align:middle" @onclick="() => PromptDeleteFolder(folder)" 
                    title="Delete folder" 
                    hidden="@(selectedFolder == "Trash" || selectedFolder == string.Empty)" 
                    disabled="@(selectedFolder == "Trash" || selectedFolder == string.Empty)">
                    <span class="bi bi-trash" aria-hidden="true"></span>
                </button>
            }
        </div>
        <button class="btn btn-outline-secondary btn-add-folder" @onclick="ShowAddFolderInput" title="Create new folder" disabled="@(selectedFolder == "Trash")">
            + New Folder
        </button>
    </div>

    @* Add folder input - shown when creating a new folder *@
    @if (showAddFolderInput)
    {
        <div class="add-folder-container">
            <input type="text" @bind="newFolderName" placeholder="Enter folder name..." class="form-control folder-name-input" @onkeydown="OnFolderInputKeyDown" />
            <button class="btn btn-primary btn-sm" @onclick="CreateFolder">Create</button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="CancelAddFolder">Cancel</button>
        </div>
    }

    @* Filter and search controls *@
    <div class="filter-container">
        @* Text search - filters by title and content *@
        <input type="text" @bind="searchQuery" @bind:event="oninput" @bind:after="OnSearchQueryChanged" placeholder="Search notes..." class="form-control search-input" />
        
        @* Note type filter dropdown *@
        <select @bind="filterType" @bind:after="OnFilterTypeChanged" class="form-select filter-select">
            <option value="">All Types</option>
            @foreach (var type in Enum.GetValues<NoteType>())
            {
                <option value="@type">@type</option>
            }
        </select>
        
        @* Color tag filter dropdown *@
        <select @bind="filterTag" @bind:after="OnFilterTagChanged" class="form-select filter-select">
            <option value="">All Tags</option>
            @foreach (var tag in Enum.GetValues<NoteTag>().Where(t => t != NoteTag.None))
            {
                <option value="@tag">@GetTagDisplayName(tag)</option>
            }
        </select>
        
        @* Sort option dropdown *@
        <select @bind="sortOption" @bind:after="OnSortOptionChanged" class="form-select sort-select">
            @foreach (var option in Enum.GetValues<SortOption>())
            {
                <option value="@option">@FilterService.GetSortOptionDisplayName(option)</option>
            }
        </select>
        
        @* Clear filters button - only shown when filters are active *@
        @if (FilterService.HasActiveFilters || !string.IsNullOrWhiteSpace(filterTag))
        {
            <button class="btn btn-outline-secondary btn-clear-filters" @onclick="ClearFilters" title="Clear all filters">
                <span class="bi bi-x-lg" aria-hidden="true"></span> Clear
            </button>
        }
    </div>

    @* Notes list or empty state message *@
    @if (FilteredNotes.Count == 0)
    {
        <p class="text-muted">@(notes.Count == 0 ? (selectedFolder == "Trash" ? "Trash is empty." : "No notes yet. Click \"Add Note\" to create your first note!") : "No notes match your search criteria.")</p>
    }
    else
    {
        <div class="notes-container">
            @foreach (var note in FilteredNotes)
            {
                <div class="note-card @GetNoteTypeClass(note.Type) @(note.IsPinned ? "pinned" : "") @GetNoteTagClass(note.Tag)">
                    <div class="note-header">
                        <div class="note-title-container">
                            @if (selectedFolder != "Trash")
                            {
                                @* Pin toggle button *@
                                    <button class="btn-pin @(note.IsPinned ? "pinned" : "")" 
                                            @onclick="() => TogglePin(note)" 
                                            title="@(note.IsPinned ? "Unpin note" : "Pin note")">
                                        <span class="bi bi-pin-angle" aria-hidden="true"></span>
                                    </button>
                            }
                            @* Color tag indicator *@
                            @if (note.Tag != NoteTag.None)
                            {
                                <span class="note-tag @GetNoteTagClass(note.Tag)" title="@GetTagDisplayName(note.Tag)">●</span>
                            }
                            <h4>@note.Title</h4>
                        </div>
                        <div class="note-badges">
                            <span class="badge badge-format" title="@GetFormatDisplayName(note.Format)">@GetFormatIcon(note.Format)</span>
                            <span class="badge">@note.Type</span>
                        </div>
                    </div>
                    
                    @* Content preview - rendered based on format and preview size setting *@
                    @if (StorageService.PreviewSize != PreviewSize.None)
                    {
                        <div class="note-content-preview preview-@StorageService.PreviewSize.ToString().ToLowerInvariant()" @onclick="() => OpenViewNote(note)" title="Click to view full note">
                            @switch (note.Format)
                            {
                                case NoteFormat.Markdown:
                                    <div class="preview-markdown">
                                        @((MarkupString)GetMarkdownPreview(note.Content))
                                    </div>
                                    break;
                            
                                case NoteFormat.RichText:
                                    <p class="note-content">@RichTextService.GetPlainTextPreview(note.Content, GetPreviewMaxLength())</p>
                                    break;
                            
                                case NoteFormat.PlainText:
                                default:
                                    <p class="note-content">@GetPlainTextPreview(note.Content, GetPreviewMaxLength())</p>
                                    break;
                            }
                        </div>
                    }
                    
                    @* Reminder-specific: Show reminder date/time *@
                    @if (note is ReminderNote reminderNote)
                    {
                        <div class="reminder-info @(reminderNote.ReminderDateTime < DateTime.Now ? "reminder-past" : "")">
                            <span class="reminder-icon bi bi-bell" aria-hidden="true"></span>
                            <span>@reminderNote.ReminderDateTime.ToString("g")</span>
                            @if (reminderNote.Recurrence != RecurrencePattern.None)
                            {
                                <span class="reminder-icon" title=$"{GetRecurrenceDisplayName(reminderNote.Recurrence)}">@GetRecurrenceIcon(reminderNote.Recurrence)</span>
                            }
                            @if (reminderNote.ReminderDateTime < DateTime.Now)
                            {
                                <span class="reminder-status">(Past)</span>
                            }
                        </div>
                    }
                    
                    @* Task-specific: Show status with quick-edit dropdown *@
                    @if (note is TaskNote taskNote)
                    {
                        <div class="task-status-info @GetTaskStatusClass(taskNote.Status)">
                            <span class="task-status-icon">@GetTaskStatusIcon(taskNote.Status)</span>
                            <select class="task-status-select" 
                                    value="@taskNote.Status" 
                                    @onchange="(e) => UpdateTaskStatus(taskNote, e)" disabled="@(selectedFolder == "Trash")">
                                @foreach (var status in Enum.GetValues<NoteTaskStatus>())
                                {
                                    <option value="@status" selected="@(taskNote.Status == status)">@GetTaskStatusDisplayName(status)</option>
                                }
                            </select>
                        </div>
                    }
                    
                    @* Note footer with dates and action buttons *@
                    <div class="note-footer">
                        <div class="note-dates">
                            <small>Created: @note.CreatedAt.ToString("g")</small>
                            <small>Modified: @note.ModifiedAt.ToString("g")</small>
                        </div>
                        <div class="note-actions">
                            @if (selectedFolder == "Trash")
                            {
                                <button class="btn btn-sm btn-success" @onclick="() => RestoreNote(note)">Restore</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => PermanentlyDeleteNote(note)">Delete Permanently</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenViewNote(note)" title="View formatted content">View</button>
                                <button class="btn btn-sm btn-secondary" @onclick="() => OpenEditNote(note)" title="Edit note">Edit</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteNote(note)" title="Delete note">Delete</button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* Delete confirmation modal - conditionally rendered *@
@if (showDeleteConfirmation)
{
    <DeleteConfirmationModal  Title= "@noteToDelete?.Title"
                              OnConfirm="ConfirmDelete"
                              OnClose="CloseDeleteConfirmation" />
}

@if (showDeleteFolderConfirmation)
{

    <DeleteConfirmationModal Title="@selectedFolder"
                             OnConfirm="ConfirmDeleteFolder"
                             OnClose="CloseDeleteFolderConfirmation" />
}

@code {
    // ============================================
    // State Variables
    // ============================================
    
    // All notes loaded from storage
    private List<Note> notes = [];
    
    // Folder state
    private List<string> folders = [];
    private string selectedFolder = string.Empty;
    private bool showAddFolderInput = false;
    private string newFolderName = string.Empty;
    
    // Filter state
    private string searchQuery = string.Empty;
    private string filterType = string.Empty;
    private string filterTag = string.Empty;
    private SortOption sortOption = SortOption.ModifiedNewest;
    
    // Delete confirmation state
    private bool showDeleteConfirmation = false;
    private Note? noteToDelete = null;

    // Folder delete state
    private string? folderToDelete = null;
    private bool showDeleteFolderConfirmation = false;

    // ============================================
    // Computed Properties
    // ============================================
    
    /// <summary>
    /// Returns the filtered and sorted list of notes based on current filter settings.
    /// Pinned notes always appear first, regardless of sort order.
    /// </summary>
    private List<Note> FilteredNotes
    {
        get
        {
            // Apply filters: search query, note type, and tag
            var filtered = notes
                .Where(n => string.IsNullOrWhiteSpace(searchQuery) ||
                            n.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                            n.Content.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
                .Where(n => string.IsNullOrWhiteSpace(filterType) ||
                            n.Type.ToString() == filterType)
                .Where(n => string.IsNullOrWhiteSpace(filterTag) ||
                            n.Tag.ToString() == filterTag);

            // Apply sorting
            filtered = sortOption switch
            {
                SortOption.ModifiedNewest => filtered.OrderByDescending(n => n.ModifiedAt),
                SortOption.ModifiedOldest => filtered.OrderBy(n => n.ModifiedAt),
                SortOption.CreatedNewest => filtered.OrderByDescending(n => n.CreatedAt),
                SortOption.CreatedOldest => filtered.OrderBy(n => n.CreatedAt),
                SortOption.TitleAZ => filtered.OrderBy(n => n.Title, StringComparer.OrdinalIgnoreCase),
                SortOption.TitleZA => filtered.OrderByDescending(n => n.Title, StringComparer.OrdinalIgnoreCase),
                _ => filtered.OrderByDescending(n => n.ModifiedAt)
            };

            // Pinned notes always float to the top
            return filtered.OrderByDescending(n => n.IsPinned).ToList();
        }
    }

    // ============================================
    // Lifecycle Methods
    // ============================================

    protected override async Task OnInitializedAsync()
    {
        // Request notification permission at startup for reminder functionality
        await NotificationService.RequestPermissionAsync();
        
        // Restore persisted filter settings
        LoadPersistedFilters();
        
        // Load folders and restore selected folder
        LoadFolders();
        selectedFolder = StorageService.CurrentFolder;
        
        // Load notes from file system
        LoadNotes();
    }

    // ============================================
    // Folder Methods
    // ============================================

    private void LoadFolders()
    {
        folders = NoteManager
        .GetSubfolders()
        .Where(f => f != "Trash") // Exclude Trash from folder list
        .OrderBy(f => f, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private void OnFolderChanged()
    {
        StorageService.CurrentFolder = selectedFolder;
        LoadNotes();
    }

    private void ShowAddFolderInput()
    {
        showAddFolderInput = true;
        newFolderName = string.Empty;
    }

    private void CancelAddFolder()
    {
        showAddFolderInput = false;
        newFolderName = string.Empty;
    }

    private void OnFolderInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            CreateFolder();
        }
        else if (e.Key == "Escape")
        {
            CancelAddFolder();
        }
    }

    private void CreateFolder()
    {
        if (string.IsNullOrWhiteSpace(newFolderName))
        {
            return;
        }

        if (NoteManager.CreateFolder(newFolderName))
        {
            LoadFolders();
            selectedFolder = newFolderName;
            StorageService.CurrentFolder = selectedFolder;
            LoadNotes();
        }

        showAddFolderInput = false;
        newFolderName = string.Empty;
    }

    private void PromptDeleteFolder(string folderName)
    {
        folderToDelete = folderName;
        showDeleteFolderConfirmation = true;
    }

    private void CloseDeleteFolderConfirmation()
    {
        folderToDelete = null;
        showDeleteFolderConfirmation = false;
    }

    private void ConfirmDeleteFolder()
    {
        if (!string.IsNullOrWhiteSpace(folderToDelete) && NoteManager.DeleteFolder(folderToDelete))
        {
            if (selectedFolder == folderToDelete)
            {
                selectedFolder = string.Empty;
                StorageService.CurrentFolder = selectedFolder;
            }
            LoadFolders();
            LoadNotes();
        }
        CloseDeleteFolderConfirmation();
    }

    // ============================================
    // Filter Methods
    // ============================================

    private void LoadPersistedFilters()
    {
        searchQuery = FilterService.SearchQuery;
        filterType = FilterService.FilterType;
        sortOption = FilterService.SortOption;
    }

    private void OnSearchQueryChanged()
    {
        FilterService.SearchQuery = searchQuery;
    }

    private void OnFilterTypeChanged()
    {
        FilterService.FilterType = filterType;
    }

    private void OnFilterTagChanged()
    {
        // Tag filter is session-only, not persisted across app restarts
    }

    private void OnSortOptionChanged()
    {
        FilterService.SortOption = sortOption;
    }

    private void ClearFilters()
    {
        searchQuery = string.Empty;
        filterType = string.Empty;
        filterTag = string.Empty;
        sortOption = SortOption.ModifiedNewest;
        FilterService.ClearFilters();
    }

    // ============================================
    // Note Operations
    // ============================================

    private void LoadNotes()
    {
        if (selectedFolder == "Trash")
            notes = NoteManager.RetrieveNotes("Trash").ToList();
        else
            notes = NoteManager.RetrieveNotes(selectedFolder).ToList();
    }

    private void OpenAddNote()
    {
        Navigation.NavigateTo("/note/new");
    }

    private void OpenViewNote(Note note)
    {
        var encodedTitle = Uri.EscapeDataString(note.Title);
        Navigation.NavigateTo($"/note/view/{encodedTitle}");
    }

    private void OpenEditNote(Note note)
    {
        var encodedTitle = Uri.EscapeDataString(note.Title);
        Navigation.NavigateTo($"/note/edit/{encodedTitle}");
    }

    private void TogglePin(Note note)
    {
        note.IsPinned = !note.IsPinned;
        NoteManager.UpdateNote(note.Title, note, selectedFolder);
        LoadNotes();
    }

    private void RestoreNote(Note note)
    {
        if (NoteManager.RestoreNoteFromTrash(note.Title))
        {
            LoadFolders(); // Refresh folder dropdown
            LoadNotes();   // Refresh notes list
        }
    }

    private void PermanentlyDeleteNote(Note note)
    {
        if (NoteManager.PermanentlyDeleteNoteFromTrash(note.Title))
        {
            LoadNotes();
        }
    }

    // ============================================
    // Delete Operations
    // ============================================

    private void DeleteNote(Note note)
    {
        noteToDelete = note;
        showDeleteConfirmation = true;
    }

    private async Task ConfirmDelete()
    {
        if (noteToDelete is not null && NoteManager.MoveNoteToTrash(noteToDelete.Title, selectedFolder))
        {
            // Cancel any scheduled notification for this note
            await NotificationService.CancelNotificationAsync($"reminder_{noteToDelete.Title}");
            LoadNotes();
        }
        CloseDeleteConfirmation();
    }

    private void CloseDeleteConfirmation()
    {
        showDeleteConfirmation = false;
        noteToDelete = null;
    }

    // ============================================
    // Task Status Quick-Update
    // ============================================

    private void UpdateTaskStatus(TaskNote taskNote, ChangeEventArgs e)
    {
        if (Enum.TryParse<NoteTaskStatus>(e.Value?.ToString(), out var newStatus))
        {
            taskNote.Status = newStatus;
            NoteManager.UpdateNote(taskNote.Title, taskNote, selectedFolder);
            LoadNotes();
        }
    }

    // ============================================
    // Display Helper Methods
    // ============================================

    private static string GetTaskStatusDisplayName(NoteTaskStatus status) => status switch
    {
        NoteTaskStatus.NotStarted => "Not Started",
        NoteTaskStatus.InProgress => "In Progress",
        NoteTaskStatus.Completed => "Completed",
        _ => status.ToString()
    };

    private static string GetTaskStatusIcon(NoteTaskStatus status) => status switch
    {
        NoteTaskStatus.NotStarted => "⏳",
        NoteTaskStatus.InProgress => "🔄",
        NoteTaskStatus.Completed => "✅",
        _ => "📋"
    };

    private static string GetTaskStatusClass(NoteTaskStatus status) => status switch
    {
        NoteTaskStatus.NotStarted => "status-not-started",
        NoteTaskStatus.InProgress => "status-in-progress",
        NoteTaskStatus.Completed => "status-completed",
        _ => ""
    };

    private static string GetTagDisplayName(NoteTag tag) => tag switch
    {
        NoteTag.None => "No Tag",
        NoteTag.Red => "Red (High Priority)",
        NoteTag.Orange => "Orange",
        NoteTag.Yellow => "Yellow",
        NoteTag.Green => "Green",
        NoteTag.Blue => "Blue",
        NoteTag.Purple => "Purple",
        _ => tag.ToString()
    };

    private static string GetNoteTagClass(NoteTag tag) => $"tag-{tag.ToString().ToLowerInvariant()}";

    private static string GetNoteTypeClass(NoteType type) => type.ToString().ToLowerInvariant();

    private static string GetFormatDisplayName(NoteFormat format) => format switch
    {
        NoteFormat.PlainText => "Plain Text",
        NoteFormat.Markdown => "Markdown",
        NoteFormat.RichText => "Rich Text",
        _ => format.ToString()
    };

    private static string GetFormatIcon(NoteFormat format) => format switch
    {
        NoteFormat.PlainText => "📄",
        NoteFormat.Markdown => "📝",
        NoteFormat.RichText => "📰",
        _ => "📄"
    };

    // ============================================
    // Preview Size Helper Methods
    // ============================================

    /// <summary>
    /// Gets the maximum character length for content preview based on the current preview size setting.
    /// </summary>
    private int GetPreviewMaxLength() => StorageService.PreviewSize switch
    {
        PreviewSize.Small => 100,
        PreviewSize.Medium => 300,
        PreviewSize.Large => 600,
        _ => 300
    };

    /// <summary>
    /// Gets the maximum source characters to use for Markdown preview.
    /// </summary>
    private int GetMarkdownPreviewSourceLength() => StorageService.PreviewSize switch
    {
        PreviewSize.Small => 200,
        PreviewSize.Medium => 500,
        PreviewSize.Large => 1000,
        _ => 500
    };

    // ============================================
    // Content Preview Helper Methods
    // ============================================

    /// <summary>
    /// Gets a short HTML preview of Markdown content for display in the note card.
    /// Renders the first part of the content with basic formatting.
    /// </summary>
    private string GetMarkdownPreview(string content)
    {
        if (string.IsNullOrWhiteSpace(content))
        {
            return string.Empty;
        }

        var maxLength = GetMarkdownPreviewSourceLength();
        var previewSource = content.Length > maxLength ? content[..maxLength] + "..." : content;
        var html = MarkdownService.ToHtml(previewSource);
        return html;
    }

    /// <summary>
    /// Gets a plain text preview with truncation.
    /// </summary>
    private static string GetPlainTextPreview(string content, int maxLength = 300)
    {
        if (string.IsNullOrWhiteSpace(content))
        {
            return string.Empty;
        }

        var text = content.Replace("\n", " ").Replace("\r", " ").Trim();
        return text.Length <= maxLength ? text : text[..maxLength].TrimEnd() + "...";
    }

    private static string GetRecurrenceIcon(RecurrencePattern recurrence) => recurrence switch
    {
        RecurrencePattern.Daily => "🔁",    // or use a calendar-repeat icon if you have SVGs
        RecurrencePattern.Weekly => "📅",
        RecurrencePattern.Monthly => "🗓️",
        _ => string.Empty
    };

    private static string GetRecurrenceDisplayName(RecurrencePattern recurrence) => recurrence switch
    {
        RecurrencePattern.Daily => "Daily Recurrence",
        RecurrencePattern.Weekly => "Weekly Recurrence",
        RecurrencePattern.Monthly => "Monthly Recurrence",
        _ => string.Empty
    };
}