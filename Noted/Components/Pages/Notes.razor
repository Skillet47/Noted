@page "/"
@using BusinessLogic.Core
@using BusinessLogic.Features.Notes
@using BusinessLogic.Models.Notes
@using Noted.Services
@inject INoteManagement NoteManager
@inject NavigationManager Navigation
@inject SidebarService SidebarService
@implements IDisposable

<div class="welcome-container">
    <div class="welcome-content">
        @if (!string.IsNullOrWhiteSpace(_saveSuccessMessage))
        {
            <div class="save-success-banner" role="status" aria-live="polite">
                <span class="bi bi-check-circle-fill" aria-hidden="true"></span>
                <span>@_saveSuccessMessage</span>
                <button class="banner-dismiss" @onclick="DismissSaveSuccess" title="Dismiss">
                    <span class="bi bi-x-lg" aria-hidden="true"></span>
                </button>
            </div>
        }

        <div class="welcome-icon"><span class="bi bi-journal-text" aria-hidden="true"></span></div>
        <h1 class="welcome-title">Welcome to Noted</h1>
        <p class="welcome-subtitle">Your personal note-taking workspace</p>

        <div class="welcome-stats">
            <div class="stat-item">
                <span class="stat-value">@_totalNotes</span>
                <span class="stat-label">Notes</span>
            </div>
            <div class="stat-item">
                <span class="stat-value">@_totalFolders</span>
                <span class="stat-label">Folders</span>
            </div>
        </div>

        <div class="welcome-actions">
            <button class="btn-primary-action" @onclick="CreateNewNote">
                <span class="bi bi-plus-lg action-icon" aria-hidden="true"></span>
                Create New Note
            </button>
        </div>

        @if (_recentNotes.Count > 0)
        {
            <div class="recent-notes">
                <h3>Recent Notes</h3>
                <div class="recent-notes-list">
                    @foreach (var item in _recentNotes)
                    {
                        <button class="recent-note-row" @onclick="() => OpenNote(item.Note, item.Folder)">
                            <span class="recent-note-title">@item.Note.Title</span>
                            <span class="recent-note-meta">
                                @(string.IsNullOrEmpty(item.Folder) ? "Root" : item.Folder) · @item.Note.ModifiedAt.ToString("g")
                            </span>
                        </button>
                    }
                </div>
            </div>
        }

        <div class="welcome-tips">
            <h3>Quick Tips</h3>
            <ul>
                <li><strong>Select a note</strong> from the sidebar to view it</li>
                <li><strong>Pin important notes</strong> by clicking the <span class="bi bi-pin-angle" aria-hidden="true"></span> icon</li>
                <li><strong>Color-coded types:</strong> 
                    <span class="type-dot type-general"></span> General,
                    <span class="type-dot type-idea"></span> Ideas, 
                    <span class="type-dot type-reminder"></span> Reminders, 
                    <span class="type-dot type-task"></span> Tasks
                </li>
                <li><strong>Organize notes</strong> into folders using the sidebar</li>
            </ul>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "saved")]
    public string? Saved { get; set; }

    private int _totalNotes;
    private int _totalFolders;
    private string _saveSuccessMessage = string.Empty;
    private List<(Note Note, string Folder)> _recentNotes = [];

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(Saved))
            return;

        _saveSuccessMessage = Saved.Equals("updated", StringComparison.OrdinalIgnoreCase)
            ? "Note updated successfully."
            : "Note created successfully.";

        // Remove query parameter so refresh doesn't keep replaying the banner state.
        Navigation.NavigateTo("/", replace: true);
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadStats();
        SidebarService.OnNotesChanged += HandleNotesChanged;
        SidebarService.OnFoldersChanged += HandleFoldersChanged;
    }

    private async Task LoadStats()
    {
        // Count root notes
        var rootNotes = await NoteManager.RetrieveNotesAsync(string.Empty);
        _totalNotes = rootNotes.Count();

        // Count folders and their notes
        var folders = NoteManager.GetSubfolders().Where(f => f != "Trash").ToList();
        _totalFolders = folders.Count;

        foreach (var folder in folders)
        {
            var folderNotes = await NoteManager.RetrieveNotesAsync(folder);
            _totalNotes += folderNotes.Count();
        }

        await LoadRecentNotes(folders);
    }

    private async Task LoadRecentNotes(IEnumerable<string> folders)
    {
        var results = new List<(Note Note, string Folder)>();

        var rootNotes = await NoteManager.RetrieveNotesAsync(string.Empty);
        results.AddRange(rootNotes.Select(note => (note, string.Empty)));

        foreach (var folder in folders)
        {
            var folderNotes = await NoteManager.RetrieveNotesAsync(folder);
            results.AddRange(folderNotes.Select(note => (note, folder)));
        }

        _recentNotes = results
            .OrderByDescending(item => item.Note.ModifiedAt)
            .Take(12)
            .ToList();
    }

    private void HandleNotesChanged()
    {
        _ = RefreshStatsSafeAsync();
    }

    private void HandleFoldersChanged()
    {
        _ = RefreshStatsSafeAsync();
    }

    private async Task RefreshStatsSafeAsync()
    {
        try
        {
            await LoadStats();
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // Prevent background event callbacks from crashing the UI tree.
        }
    }

    private void CreateNewNote()
    {
        SidebarService.CurrentFolder = string.Empty;
        Navigation.NavigateTo("/note/new");
    }

    private void OpenNote(Note note, string folder)
    {
        SidebarService.SelectNote(note.Title, folder, selectedInPinnedSection: false);
        Navigation.NavigateTo($"/note/view/{Uri.EscapeDataString(note.Title)}");
    }

    private void DismissSaveSuccess()
    {
        _saveSuccessMessage = string.Empty;
    }

    public void Dispose()
    {
        SidebarService.OnNotesChanged -= HandleNotesChanged;
        SidebarService.OnFoldersChanged -= HandleFoldersChanged;
    }
}