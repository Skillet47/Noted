@page "/"
@using BusinessLogic.Core
@using Noted.Services
@inject INoteManagement NoteManager
@inject NavigationManager Navigation
@inject SidebarService SidebarService
@implements IDisposable

<div class="welcome-container">
    <div class="welcome-content">
        <div class="welcome-icon"><span class="bi bi-journal-text" aria-hidden="true"></span></div>
        <h1 class="welcome-title">Welcome to Noted</h1>
        <p class="welcome-subtitle">Your personal note-taking workspace</p>

        <div class="welcome-stats">
            <div class="stat-item">
                <span class="stat-value">@_totalNotes</span>
                <span class="stat-label">Notes</span>
            </div>
            <div class="stat-item">
                <span class="stat-value">@_totalFolders</span>
                <span class="stat-label">Folders</span>
            </div>
        </div>

        <div class="welcome-actions">
            <button class="btn-primary-action" @onclick="CreateNewNote">
                <span class="bi bi-plus-lg action-icon" aria-hidden="true"></span>
                Create New Note
            </button>
        </div>

        <div class="welcome-tips">
            <h3>Quick Tips</h3>
            <ul>
                <li><strong>Select a note</strong> from the sidebar to view it</li>
                <li><strong>Pin important notes</strong> by clicking the <span class="bi bi-pin-angle" aria-hidden="true"></span> icon</li>
                <li><strong>Color-coded types:</strong> 
                    <span class="type-dot type-idea"></span> Ideas, 
                    <span class="type-dot type-reminder"></span> Reminders, 
                    <span class="type-dot type-task"></span> Tasks
                </li>
                <li><strong>Organize notes</strong> into folders using the sidebar</li>
            </ul>
        </div>
    </div>
</div>

@code {
    private int _totalNotes;
    private int _totalFolders;

    protected override async Task OnInitializedAsync()
    {
        await LoadStats();
        SidebarService.OnNotesChanged += HandleNotesChanged;
        SidebarService.OnFoldersChanged += HandleFoldersChanged;
    }

    private async Task LoadStats()
    {
        // Count root notes
        var rootNotes = await NoteManager.RetrieveNotesAsync(string.Empty);
        _totalNotes = rootNotes.Count();

        // Count folders and their notes
        var folders = NoteManager.GetSubfolders().Where(f => f != "Trash").ToList();
        _totalFolders = folders.Count;

        foreach (var folder in folders)
        {
            var folderNotes = await NoteManager.RetrieveNotesAsync(folder);
            _totalNotes += folderNotes.Count();
        }
    }

    private async void HandleNotesChanged()
    {
        await LoadStats();
        await InvokeAsync(StateHasChanged);
    }

    private async void HandleFoldersChanged()
    {
        await LoadStats();
        await InvokeAsync(StateHasChanged);
    }

    private void CreateNewNote()
    {
        Navigation.NavigateTo("/note/new");
    }

    public void Dispose()
    {
        SidebarService.OnNotesChanged -= HandleNotesChanged;
        SidebarService.OnFoldersChanged -= HandleFoldersChanged;
    }
}