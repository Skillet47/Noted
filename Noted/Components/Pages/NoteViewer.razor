@page "/note/view/{NoteTitle}"
@using BusinessLogic.Core
@using BusinessLogic.Notes
@using Noted.Services
@using Noted.Components.Modals
@inject INoteManagement NoteManager
@inject INotificationService NotificationService
@inject SidebarService SidebarService
@inject MarkdownService MarkdownService
@inject RichTextService RichTextService
@inject NavigationManager Navigation

<div class="note-viewer-container">
    @if (_note is null)
    {
        <div class="loading-container">
            <div class="loading-spinner">
                <span class="bi bi-hourglass-split" aria-hidden="true"></span>
            </div>
            <p>Loading note...</p>
        </div>
    }
    else
    {
        <header class="note-viewer-header">
            <div class="header-top">
                <button class="btn-back" @onclick="HandleBack" title="Back to home">
                    <span class="bi bi-arrow-left" aria-hidden="true"></span> Back
                </button>
                <div class="header-actions">
                    @if (IsTrashNote)
                    {
                        <button class="btn btn-success" @onclick="HandleRestore" title="Restore note">
                            <span class="bi bi-arrow-counterclockwise" aria-hidden="true"></span> Restore
                        </button>
                        <button class="btn btn-danger" @onclick="PromptPermanentDelete" title="Delete permanently">
                            <span class="bi bi-trash" aria-hidden="true"></span> Delete Forever
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-primary" @onclick="HandleEdit" title="Edit note">
                            <span class="bi bi-pencil" aria-hidden="true"></span> Edit
                        </button>
                        <button class="btn btn-outline-danger" @onclick="PromptDelete" title="Move to trash">
                            <span class="bi bi-trash" aria-hidden="true"></span>
                        </button>
                    }
                </div>
            </div>
            <div class="note-title-section">
                <div class="title-icon">
                    <span class="bi bi-file-text" aria-hidden="true"></span>
                </div>
                <div class="title-content">
                    <h1>@_note.Title</h1>
                    <div class="note-badges">
                        @if (_note.Tag != NoteTag.None)
                        {
                            <span class="note-tag @GetNoteTagClass(_note.Tag)" title="@GetTagDisplayName(_note.Tag)"></span>
                        }
                        <span class="badge badge-format" title="@GetFormatDisplayName(_note.Format)">@GetFormatIcon(_note.Format)</span>
                        <span class="badge badge-type @GetNoteTypeClass(_note.Type)">@_note.Type</span>
                        @if (_note.IsPinned)
                        {
                            <span class="badge badge-pinned" title="Pinned"><span class="bi bi-pin-angle-fill" aria-hidden="true"></span></span>
                        }
                    </div>
                </div>
            </div>
        </header>

        @* Note location/path *@
        <div class="note-location">
            <span class="bi bi-folder2 location-icon" aria-hidden="true"></span>
            <span class="location-path">
                @if (IsTrashNote)
                {
                    <span class="trash-indicator">
                        <span class="bi bi-trash" aria-hidden="true"></span> Trash
                    </span>
                    <span class="original-path">(originally in: @(string.IsNullOrEmpty(_originalFolder) ? "Root" : _originalFolder))</span>
                }
                else if (string.IsNullOrEmpty(_currentFolder))
                {
                    <span>Root</span>
                }
                else
                {
                    <span>@_currentFolder</span>
                }
            </span>
        </div>

        @* Note metadata section *@
        <div class="note-metadata">
            <div class="metadata-item">
                <span class="metadata-label"><span class="bi bi-calendar-plus" aria-hidden="true"></span> Created:</span>
                <span class="metadata-value">@_note.CreatedAt.ToString("f")</span>
            </div>
            <div class="metadata-item">
                <span class="metadata-label"><span class="bi bi-calendar-check" aria-hidden="true"></span> Modified:</span>
                <span class="metadata-value">@_note.ModifiedAt.ToString("f")</span>
            </div>

            @* Reminder-specific metadata *@
            @if (_note is ReminderNote reminderNote)
            {
                <div class="metadata-item reminder-metadata @(reminderNote.ReminderDateTime < DateTime.Now ? "reminder-past" : "")">
                    <span class="metadata-label"><span class="bi bi-bell" aria-hidden="true"></span> Reminder:</span>
                    <span class="metadata-value">
                        @reminderNote.ReminderDateTime.ToString("f")
                        @if (reminderNote.Recurrence != RecurrencePattern.None)
                        {
                            <span class="bi @GetRecurrenceIcon(reminderNote.Recurrence)" title="@GetRecurrenceDisplayName(reminderNote.Recurrence)" aria-hidden="true"></span>
                        }
                        @if (reminderNote.ReminderDateTime < DateTime.Now)
                        {
                            <span class="reminder-status">(Past)</span>
                        }
                    </span>
                </div>
            }

            @* Task-specific metadata *@
            @if (_note is TaskNote taskNote)
            {
                <div class="metadata-item task-metadata @GetTaskStatusClass(taskNote.Status)">
                    <span class="metadata-label"><span class="bi @GetTaskStatusIcon(taskNote.Status)" aria-hidden="true"></span> Status:</span>
                    <span class="metadata-value">@GetTaskStatusDisplayName(taskNote.Status)</span>
                </div>
            }
        </div>

        @* Rendered content based on format *@
        <div class="note-content-container">
            @switch (_note.Format)
            {
                case NoteFormat.Markdown:
                    <div class="markdown-content">
                        @((MarkupString)MarkdownService.ToHtml(_note.Content))
                    </div>
                    break;

                case NoteFormat.RichText:
                    <div class="richtext-content">
                        @((MarkupString)RichTextService.ToHtml(_note.Content))
                    </div>
                    break;

                case NoteFormat.PlainText:
                default:
                    <div class="plaintext-content">
                        <pre>@_note.Content</pre>
                    </div>
                    break;
            }
        </div>
    }
</div>

@* Delete confirmation modal *@
@if (_showDeleteConfirmation)
{
    <DeleteConfirmationModal Title="@_note?.Title"
                             OnConfirm="ConfirmDelete"
                             OnClose="CancelDelete" />
}

@* Permanent delete confirmation *@
@if (_showPermanentDeleteConfirmation)
{
    <div class="delete-overlay" @onclick="CancelDelete">
        <div class="delete-dialog" @onclick:stopPropagation="true">
            <p><span class="bi bi-exclamation-triangle text-danger" aria-hidden="true"></span> <strong>Permanently delete</strong> "@_note?.Title"?</p>
            <p class="delete-warning">This action cannot be undone. The note will be deleted forever.</p>
            <div class="delete-actions">
                <button class="btn-cancel" @onclick="CancelDelete">Cancel</button>
                <button class="btn-delete" @onclick="ConfirmPermanentDelete">Delete Forever</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? NoteTitle { get; set; }

    private Note? _note;
    private string _currentFolder = string.Empty;
    private string? _originalFolder;
    private bool _showDeleteConfirmation;
    private bool _showPermanentDeleteConfirmation;

    private bool IsTrashNote => _currentFolder == "Trash";

    protected override async Task OnInitializedAsync()
    {
        await LoadNoteAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Reload note when URL parameter changes (clicking different notes)
        await LoadNoteAsync();
    }

    private async Task LoadNoteAsync()
    {
        if (string.IsNullOrEmpty(NoteTitle))
        {
            Navigation.NavigateTo("/");
            return;
        }

        _currentFolder = SidebarService.CurrentFolder;
        var decodedTitle = Uri.UnescapeDataString(NoteTitle);
        var notes = await NoteManager.RetrieveNotesAsync(_currentFolder);
        _note = notes.FirstOrDefault(n => n.Title == decodedTitle);

        if (_note is null)
        {
            Navigation.NavigateTo("/");
        }
        else if (IsTrashNote)
        {
            // For trash notes, read the original folder from the note metadata
            _originalFolder = _note.OriginalFolder;
        }
    }

    private void HandleBack()
    {
        Navigation.NavigateTo("/");
    }

    private void HandleEdit()
    {
        if (_note is null) return;
        var encodedTitle = Uri.EscapeDataString(_note.Title);
        Navigation.NavigateTo($"/note/edit/{encodedTitle}");
    }

    // Delete operations
    private void PromptDelete()
    {
        _showDeleteConfirmation = true;
    }

    private void PromptPermanentDelete()
    {
        _showPermanentDeleteConfirmation = true;
    }

    private void CancelDelete()
    {
        _showDeleteConfirmation = false;
        _showPermanentDeleteConfirmation = false;
    }

    private async Task ConfirmDelete()
    {
        if (_note is not null)
        {
            if (await NoteManager.MoveNoteToTrashAsync(_note.Title, _currentFolder))
            {
                // Cancel any scheduled notification
                await NotificationService.CancelNotificationAsync($"reminder_{_note.Title}");
                SidebarService.NotifyNotesChanged();
                Navigation.NavigateTo("/");
            }
        }
        _showDeleteConfirmation = false;
    }

    private async Task ConfirmPermanentDelete()
    {
        if (_note is not null)
        {
            if (await NoteManager.PermanentlyDeleteNoteFromTrashAsync(_note.Title))
            {
                SidebarService.NotifyNotesChanged();
                Navigation.NavigateTo("/");
            }
        }
        _showPermanentDeleteConfirmation = false;
    }

    private async Task HandleRestore()
    {
        if (_note is not null)
        {
            if (await NoteManager.RestoreNoteFromTrashAsync(_note.Title))
            {
                SidebarService.NotifyNotesChanged();
                SidebarService.NotifyFoldersChanged();
                Navigation.NavigateTo("/");
            }
        }
    }

    // Display helper methods
    private static string GetTagDisplayName(NoteTag tag) => tag switch
    {
        NoteTag.None => "No Tag",
        NoteTag.Red => "Red (High Priority)",
        NoteTag.Orange => "Orange",
        NoteTag.Yellow => "Yellow",
        NoteTag.Green => "Green",
        NoteTag.Blue => "Blue",
        NoteTag.Purple => "Purple",
        _ => tag.ToString()
    };

    private static string GetNoteTagClass(NoteTag tag) => $"tag-{tag.ToString().ToLowerInvariant()}";

    private static string GetNoteTypeClass(NoteType type) => type.ToString().ToLowerInvariant();

    private static string GetFormatDisplayName(NoteFormat format) => format switch
    {
        NoteFormat.PlainText => "Plain Text",
        NoteFormat.Markdown => "Markdown",
        NoteFormat.RichText => "Rich Text",
        _ => format.ToString()
    };

    private static string GetFormatIcon(NoteFormat format) => format switch
    {
        NoteFormat.PlainText => "txt",
        NoteFormat.Markdown => "md",
        NoteFormat.RichText => "rtf",
        _ => "txt"
    };

    private static string GetTaskStatusDisplayName(NoteTaskStatus status) => status switch
    {
        NoteTaskStatus.NotStarted => "Not Started",
        NoteTaskStatus.InProgress => "In Progress",
        NoteTaskStatus.Completed => "Completed",
        _ => status.ToString()
    };

    private static string GetTaskStatusIcon(NoteTaskStatus status) => status switch
    {
        NoteTaskStatus.NotStarted => "bi-hourglass",
        NoteTaskStatus.InProgress => "bi-arrow-repeat",
        NoteTaskStatus.Completed => "bi-check-circle",
        _ => "bi-clipboard"
    };

    private static string GetTaskStatusClass(NoteTaskStatus status) => status switch
    {
        NoteTaskStatus.NotStarted => "status-not-started",
        NoteTaskStatus.InProgress => "status-in-progress",
        NoteTaskStatus.Completed => "status-completed",
        _ => ""
    };

    private static string GetRecurrenceIcon(RecurrencePattern recurrence) => recurrence switch
    {
        RecurrencePattern.Daily => "bi-arrow-repeat",
        RecurrencePattern.Weekly => "bi-calendar-week",
        RecurrencePattern.Monthly => "bi-calendar-month",
        _ => string.Empty
    };

    private static string GetRecurrenceDisplayName(RecurrencePattern recurrence) => recurrence switch
    {
        RecurrencePattern.Daily => "Daily Recurrence",
        RecurrencePattern.Weekly => "Weekly Recurrence",
        RecurrencePattern.Monthly => "Monthly Recurrence",
        _ => string.Empty
    };
}
