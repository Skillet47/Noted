@page "/note/view/{NoteTitle}"
@using BusinessLogic.Core
@using BusinessLogic.Features.Notes
@using BusinessLogic.Models.Notes
@using BusinessLogic.Shared
@using Noted.Services
@using Noted.Components.Modals
@inject INoteManagement NoteManager
@inject INotificationService NotificationService
@inject SidebarService SidebarService
@inject MarkdownService MarkdownService
@inject RichTextService RichTextService
@inject NavigationManager Navigation

<div class="note-viewer-container">
    @if (_note is null)
    {
        <div class="loading-container">
            <div class="loading-spinner">
                <span class="bi bi-hourglass-split" aria-hidden="true"></span>
            </div>
            <p>Loading note...</p>
        </div>
    }
    else
    {
        <header class="note-viewer-header">
            <div class="header-top">
                <button class="btn-back" @onclick="HandleBack" title="Back to home">
                    <span class="bi bi-arrow-left" aria-hidden="true"></span>
                </button>
                <div class="header-actions">
                    <button class="viewer-action viewer-action-secondary" @onclick="ToggleHistory" title="Toggle change history (@_historyEntries.Count snapshot(s))">
                        <span class="bi bi-clock-history" aria-hidden="true"></span>
                    </button>
                    @if (IsTrashNote)
                    {
                        <button class="viewer-action viewer-action-success" @onclick="HandleRestore" title="Restore note">
                            <span class="bi bi-arrow-counterclockwise" aria-hidden="true"></span>
                        </button>
                        <button class="viewer-action viewer-action-danger" @onclick="PromptPermanentDelete" title="Delete permanently">
                            <span class="bi bi-trash" aria-hidden="true"></span>
                        </button>
                    }
                    else
                    {
                        <button class="viewer-action viewer-action-primary" @onclick="HandleEdit" title="Edit note">
                            <span class="bi bi-pencil" aria-hidden="true"></span>
                        </button>
                        <button class="viewer-action viewer-action-secondary" @onclick="PromptMove" title="Move to folder">
                            <span class="bi bi-folder-symlink" aria-hidden="true"></span>
                        </button>
                        <button class="viewer-action viewer-action-ghost-danger" @onclick="PromptDelete" title="Move to trash">
                            <span class="bi bi-trash" aria-hidden="true"></span>
                        </button>
                    }
                </div>
            </div>
            <div class="note-title-section">
                <div class="title-content">
                    <h1>@_note.Title</h1>
                    <div class="note-badges">
                        @if (_note.Tag != NoteTag.None)
                        {
                            <span class="badge badge-tag @GetNoteTagClass(_note.Tag)" title="@GetTagDisplayName(_note.Tag)">
                                <span class="bi bi-tag-fill tag-icon" aria-hidden="true"></span>
                                <span>@GetTagDisplayName(_note.Tag)</span>
                            </span>
                        }
                        <span class="badge badge-format" title="@GetFormatDisplayName(_note.Format)">@GetFormatIcon(_note.Format)</span>
                        <span class="badge badge-type @GetNoteTypeClass(_note.Type)">@_note.Type</span>
                        @if (_note.IsPinned)
                        {
                            <span class="badge badge-pinned" title="Pinned"><span class="bi bi-pin-angle-fill" aria-hidden="true"></span></span>
                        }
                        <button class="badge-info-button" @onclick="OpenMetadataModal" aria-label="Note information">
                            <span class="bi bi-info-circle" aria-hidden="true"></span>
                        </button>
                    </div>
                </div>
            </div>
        </header>

        @* Type-specific metadata displayed immediately *@
        @if (_note is ReminderNote reminderNoteEntry)
        {
            <div class="note-metadata-bar reminder-bar">
                <div class="metadata-bar-item">
                    <span class="bi bi-bell" aria-hidden="true"></span>
                    <span class="metadata-bar-label">Reminder:</span>
                    <span class="metadata-bar-value @(reminderNoteEntry.ReminderDateTime < DateTime.Now ? "past-reminder" : "")">
                        @reminderNoteEntry.ReminderDateTime.ToString("f")
                        @if (reminderNoteEntry.ReminderDateTime < DateTime.Now)
                        {
                            <span class="past-indicator">(Past)</span>
                        }
                    </span>
                </div>
                @if (reminderNoteEntry.Recurrence != RecurrencePattern.None)
                {
                    <div class="metadata-bar-item">
                        <span class="bi @GetRecurrenceIcon(reminderNoteEntry.Recurrence)" aria-hidden="true"></span>
                        <span class="metadata-bar-label">Recurrence:</span>
                        <span class="metadata-bar-value">@GetRecurrenceDisplayName(reminderNoteEntry.Recurrence)</span>
                    </div>
                }
            </div>
        }
        else if (_note is TaskNote taskNoteEntry)
        {
            <div class="note-metadata-bar task-bar">
                <div class="metadata-bar-item">
                    <span class="bi @GetTaskStatusIcon(taskNoteEntry.Status)" aria-hidden="true"></span>
                    <span class="metadata-bar-label">Status:</span>
                    <span class="metadata-bar-value @GetTaskStatusClass(taskNoteEntry.Status)">
                        @GetTaskStatusDisplayName(taskNoteEntry.Status)
                    </span>
                </div>
            </div>
        }
        else if (_note is IdeaNote ideaNoteEntry)
        {
            <div class="note-metadata-bar idea-bar">
                <div class="metadata-bar-item">
                    <span class="bi bi-lightbulb" aria-hidden="true"></span>
                    <span class="metadata-bar-label">Stage:</span>
                    <span class="metadata-bar-value">@GetIdeaStageDisplayName(ideaNoteEntry.Stage)</span>
                </div>
                <div class="metadata-bar-item">
                    <span class="bi bi-compass" aria-hidden="true"></span>
                    <span class="metadata-bar-label">Next Step:</span>
                    <span class="metadata-bar-value">@ideaNoteEntry.GetFocusPrompt()</span>
                </div>
            </div>
        }

        @if (_showHistory)
        {
            <section class="note-history-panel">
                <div class="history-panel-header">
                    <h2><span class="bi bi-clock-history" aria-hidden="true"></span> Change History</h2>
                    <span class="history-count">@_historyEntries.Count snapshot(s)</span>
                </div>

                @if (!string.IsNullOrEmpty(_historyError))
                {
                    <p class="history-error">@_historyError</p>
                }
                else if (_historyEntries.Count == 0)
                {
                    <p class="history-empty">No history yet. Save edits to create snapshots.</p>
                }
                else
                {
                    <ul class="history-list">
                        @foreach (var entry in _historyEntries)
                        {
                            <li class="history-entry">
                                <div class="history-entry-header">
                                    <div class="history-entry-meta">
                                        <span class="history-time">@entry.ChangedAtUtc.ToLocalTime().ToString("f")</span>
                                        <span class="history-pill">@entry.Type</span>
                                        <span class="history-pill">@entry.Format</span>
                                        @if (entry.IsPinned)
                                        {
                                            <span class="history-pill">Pinned</span>
                                        }
                                    </div>
                                    @if (!IsTrashNote)
                                    {
                                        <button class="viewer-action viewer-action-secondary viewer-action-small"
                                                disabled="@_isReverting"
                                                title="Revert to this snapshot"
                                                @onclick="() => HandleRevertHistory(entry)">
                                            <span class="bi bi-arrow-counterclockwise" aria-hidden="true"></span>
                                        </button>
                                    }
                                </div>
                                @if (!string.Equals(entry.Title, _note.Title, StringComparison.Ordinal))
                                {
                                    <p class="history-title-change">Title at that point: @entry.Title</p>
                                }
                                <p class="history-preview">@GetHistoryContentPreview(entry.Content)</p>
                            </li>
                        }
                    </ul>
                }
            </section>
        }

        @* Rendered content based on format *@
        <div class="note-content-container">
            @switch (_note.Format)
            {
                case NoteFormat.Markdown:
                    <div class="markdown-content">
                        @((MarkupString)MarkdownService.ToHtml(_note.Content))
                    </div>
                    break;

                case NoteFormat.RichText:
                    <div class="richtext-content">
                        @((MarkupString)RichTextService.ToHtml(_note.Content))
                    </div>
                    break;

                case NoteFormat.PlainText:
                default:
                    <div class="plaintext-content">
                        <pre>@_note.Content</pre>
                    </div>
                    break;
            }
        </div>
    }
</div>

@* Delete confirmation modal *@
@if (_showDeleteConfirmation)
{
    <DeleteConfirmationModal Title="@_note?.Title"
                             OnConfirm="ConfirmDelete"
                             OnClose="CancelDelete" />
}

@* Permanent delete confirmation *@
@if (_showPermanentDeleteConfirmation)
{
    <div class="delete-overlay" @onclick="CancelDelete">
        <div class="delete-dialog" @onclick:stopPropagation="true">
            <p><span class="bi bi-exclamation-triangle text-danger" aria-hidden="true"></span> <strong>Permanently delete</strong> "@_note?.Title"?</p>
            <p class="delete-warning">This action cannot be undone. The note will be deleted forever.</p>
            <div class="delete-actions">
                <button class="btn-cancel" @onclick="CancelDelete" title="Cancel delete">
                    <span class="bi bi-x-lg" aria-hidden="true"></span>
                </button>
                <button class="btn-delete" @onclick="ConfirmPermanentDelete" title="Delete forever">
                    <span class="bi bi-trash" aria-hidden="true"></span>
                </button>
            </div>
        </div>
    </div>
}

@* Move to folder modal *@
@if (_showMoveFolderModal)
{
    <MoveFolderModal NoteTitle="@_note?.Title"
                     CurrentFolder="@_currentFolder"
                     AvailableFolders="_moveFolderOptions"
                     OnFolderSelected="HandleMoveFolderSelected"
                     OnClose="CancelMove" />
}

@* Metadata info modal *@
@if (_showMetadataModal)
{
    <div class="metadata-overlay" @onclick="CloseMetadataModal">
        <div class="metadata-modal" @onclick:stopPropagation="true">
            <div class="metadata-modal-header">
                <h2>Note Information</h2>
                <button class="modal-close-btn" @onclick="CloseMetadataModal" title="Close">
                    <span class="bi bi-x-lg" aria-hidden="true"></span>
                </button>
            </div>
            <div class="metadata-modal-content">
                <div class="metadata-section">
                    <h3><span class="bi bi-folder2" aria-hidden="true"></span> Location</h3>
                    @if (IsTrashNote)
                    {
                        <p class="trash-location">
                            <span class="bi bi-trash" aria-hidden="true"></span> Trash
                            @if (!string.IsNullOrEmpty(_originalFolder))
                            {
                                <span class="original-location">(originally in: @_originalFolder)</span>
                            }
                        </p>
                    }
                    else
                    {
                        <p>@(string.IsNullOrEmpty(_currentFolder) ? "Root" : _currentFolder)</p>
                    }
                </div>

                <div class="metadata-section">
                    <h3><span class="bi bi-calendar" aria-hidden="true"></span> Dates</h3>
                    <div class="date-info">
                        <div class="date-item">
                            <span class="date-label">Created:</span>
                            <span class="date-value">@_note?.CreatedAt.ToString("f")</span>
                        </div>
                        <div class="date-item">
                            <span class="date-label">Modified:</span>
                            <span class="date-value">@_note?.ModifiedAt.ToString("f")</span>
                        </div>
                    </div>
                </div>

                @if (_note is ReminderNote reminderNoteEntry)
                {
                    <div class="metadata-section">
                        <h3><span class="bi bi-bell" aria-hidden="true"></span> Reminder</h3>
                        <div class="reminder-info">
                            <div class="reminder-item">
                                <span class="reminder-label">Date & Time:</span>
                                <span class="reminder-value @(reminderNoteEntry.ReminderDateTime < DateTime.Now ? "past-reminder" : "")">
                                    @reminderNoteEntry.ReminderDateTime.ToString("f")
                                    @if (reminderNoteEntry.ReminderDateTime < DateTime.Now)
                                    {
                                        <span class="past-badge">(Past)</span>
                                    }
                                </span>
                            </div>
                            @if (reminderNoteEntry.Recurrence != RecurrencePattern.None)
                            {
                                <div class="reminder-item">
                                    <span class="reminder-label">Recurrence:</span>
                                    <span class="reminder-value">@GetRecurrenceDisplayName(reminderNoteEntry.Recurrence)</span>
                                </div>
                            }
                        </div>
                    </div>
                }
                else if (_note is TaskNote taskNoteEntry)
                {
                    <div class="metadata-section">
                        <h3><span class="bi @GetTaskStatusIcon(taskNoteEntry.Status)" aria-hidden="true"></span> Task Status</h3>
                        <p class="task-status @GetTaskStatusClass(taskNoteEntry.Status)">
                            @GetTaskStatusDisplayName(taskNoteEntry.Status)
                        </p>
                    </div>
                }
                else if (_note is IdeaNote ideaNoteEntry)
                {
                    <div class="metadata-section">
                        <h3><span class="bi bi-lightbulb" aria-hidden="true"></span> Idea Information</h3>
                        <div class="idea-info">
                            <div class="idea-item">
                                <span class="idea-label">Stage:</span>
                                <span class="idea-value">@GetIdeaStageDisplayName(ideaNoteEntry.Stage)</span>
                            </div>
                            <div class="idea-item">
                                <span class="idea-label">Next Step:</span>
                                <span class="idea-value">@ideaNoteEntry.GetFocusPrompt()</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? NoteTitle { get; set; }

    private Note? _note;
    private string _currentFolder = string.Empty;
    private string? _originalFolder;
    private bool _showDeleteConfirmation;
    private bool _showPermanentDeleteConfirmation;
    private bool _showMoveFolderModal;
    private bool _showMetadataModal;
    private IReadOnlyList<string> _moveFolderOptions = [];
    private bool _showHistory;
    private bool _isReverting;
    private string? _historyError;
    private List<NoteHistoryEntry> _historyEntries = [];

    private bool IsTrashNote => _currentFolder == "Trash";

    protected override async Task OnInitializedAsync()
    {
        await LoadNoteAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Reload note when URL parameter changes (clicking different notes)
        await LoadNoteAsync();
    }

    private async Task LoadNoteAsync()
    {
        if (string.IsNullOrEmpty(NoteTitle))
        {
            Navigation.NavigateTo("/");
            return;
        }

        _currentFolder = SidebarService.CurrentFolder;
        var decodedTitle = Uri.UnescapeDataString(NoteTitle);
        var notes = await NoteManager.RetrieveNotesAsync(_currentFolder);
        _note = notes.FirstOrDefault(n => n.Title == decodedTitle);

        if (_note is null)
        {
            _historyEntries = [];
            Navigation.NavigateTo("/");
        }
        else if (IsTrashNote)
        {
            // For trash notes, read the original folder from the note metadata
            _originalFolder = _note.OriginalFolder;
            await LoadHistoryAsync();
        }
        else
        {
            _originalFolder = null;
            await LoadHistoryAsync();
        }
    }

    private void ToggleHistory()
    {
        _showHistory = !_showHistory;
    }

    private async Task LoadHistoryAsync()
    {
        if (_note is null)
        {
            _historyEntries = [];
            return;
        }

        _historyError = null;

        try
        {
            var history = await NoteManager.GetNoteHistoryAsync(_note.Title, _currentFolder);
            _historyEntries = history.OrderByDescending(entry => entry.ChangedAtUtc).ToList();
        }
        catch
        {
            _historyEntries = [];
            _historyError = "Unable to load history right now.";
        }
    }

    private async Task HandleRevertHistory(NoteHistoryEntry entry)
    {
        if (_note is null)
            return;

        _isReverting = true;
        _historyError = null;

        var currentTitle = _note.Title;
        var result = await NoteManager.RevertNoteToHistoryAsync(currentTitle, entry.ChangedAtUtc, _currentFolder);

        _isReverting = false;

        if (!result.Success)
        {
            _historyError = result.ErrorMessage ?? "Could not revert this snapshot.";
            return;
        }

        SidebarService.NotifyNotesChanged();

        if (!string.Equals(entry.Title, currentTitle, StringComparison.Ordinal))
        {
            var encodedTitle = Uri.EscapeDataString(entry.Title);
            Navigation.NavigateTo($"/note/view/{encodedTitle}", forceLoad: false);
            return;
        }

        await LoadNoteAsync();
    }

    private void HandleBack()
    {
        Navigation.NavigateTo("/");
    }

    private void HandleEdit()
    {
        if (_note is null) return;
        var encodedTitle = Uri.EscapeDataString(_note.Title);
        Navigation.NavigateTo($"/note/edit/{encodedTitle}");
    }

    // Delete operations
    private void PromptDelete()
    {
        _showDeleteConfirmation = true;
    }

    private void PromptPermanentDelete()
    {
        _showPermanentDeleteConfirmation = true;
    }

    private void CancelDelete()
    {
        _showDeleteConfirmation = false;
        _showPermanentDeleteConfirmation = false;
    }

    private void PromptMove()
    {
        var allFolders = NoteManager.GetSubfolders()
            .Where(f => f != "Trash")
            .OrderBy(f => f, StringComparer.OrdinalIgnoreCase)
            .ToList();

        // Prepend root option (empty string = root)
        _moveFolderOptions = new[] { string.Empty }.Concat(allFolders).ToList();
        _showMoveFolderModal = true;
    }

    private void CancelMove()
    {
        _showMoveFolderModal = false;
    }

    private async Task HandleMoveFolderSelected(string destinationFolder)
    {
        _showMoveFolderModal = false;

        if (_note is null)
            return;

        var result = await NoteManager.MoveNoteAsync(_note.Title, _currentFolder, destinationFolder);
        if (!result.Success)
            return;

        _currentFolder = destinationFolder;
        SidebarService.SelectNote(_note.Title, destinationFolder, selectedInPinnedSection: false);
        SidebarService.NotifyNotesChanged();
        SidebarService.NotifyFoldersChanged();

        var encodedTitle = Uri.EscapeDataString(_note.Title);
        Navigation.NavigateTo($"/note/view/{encodedTitle}", forceLoad: false);
    }

    private async Task ConfirmDelete()
    {
        if (_note is not null)
        {
            if (await NoteManager.MoveNoteToTrashAsync(_note.Title, _currentFolder))
            {
                // Cancel any scheduled notification
                await NotificationService.CancelNotificationAsync($"reminder_{_note.Title}");
                SidebarService.NotifyNotesChanged();
                Navigation.NavigateTo("/");
            }
        }
        _showDeleteConfirmation = false;
    }

    private async Task ConfirmPermanentDelete()
    {
        if (_note is not null)
        {
            if (await NoteManager.PermanentlyDeleteNoteFromTrashAsync(_note.Title))
            {
                SidebarService.NotifyNotesChanged();
                Navigation.NavigateTo("/");
            }
        }
        _showPermanentDeleteConfirmation = false;
    }

    private async Task HandleRestore()
    {
        if (_note is not null)
        {
            if (await NoteManager.RestoreNoteFromTrashAsync(_note.Title))
            {
                SidebarService.NotifyNotesChanged();
                SidebarService.NotifyFoldersChanged();
                Navigation.NavigateTo("/");
            }
        }
    }

    // Metadata modal
    private List<string> _metadataLines = new();

    private void OpenMetadataModal()
    {
        if (_note is null)
            return;

        _metadataLines.Clear();

        // Location
        if (IsTrashNote)
        {
            _metadataLines.Add($"📁 Location: Trash");
            if (!string.IsNullOrEmpty(_originalFolder))
                _metadataLines.Add($"   (originally in: {_originalFolder})");
        }
        else
        {
            _metadataLines.Add($"📁 Location: {(string.IsNullOrEmpty(_currentFolder) ? "Root" : _currentFolder)}");
        }

        // Created and modified dates
        _metadataLines.Add($"📅 Created: {_note.CreatedAt:f}");
        _metadataLines.Add($"📝 Modified: {_note.ModifiedAt:f}");

        // Type-specific metadata
        if (_note is ReminderNote reminderNoteEntry)
        {
            var reminderLine = $"🔔 Reminder: {reminderNoteEntry.ReminderDateTime:f}";
            if (reminderNoteEntry.Recurrence != RecurrencePattern.None)
                reminderLine += $" ({GetRecurrenceDisplayName(reminderNoteEntry.Recurrence)})";
            if (reminderNoteEntry.ReminderDateTime < DateTime.Now)
                reminderLine += " (Past)";
            _metadataLines.Add(reminderLine);
        }
        else if (_note is TaskNote taskNoteEntry)
        {
            _metadataLines.Add($"✓ Status: {GetTaskStatusDisplayName(taskNoteEntry.Status)}");
        }
        else if (_note is IdeaNote ideaNoteEntry)
        {
            _metadataLines.Add($"💡 Idea Stage: {GetIdeaStageDisplayName(ideaNoteEntry.Stage)}");
            _metadataLines.Add($"🧭 Next Step: {ideaNoteEntry.GetFocusPrompt()}");
        }

        _showMetadataModal = true;
    }

    private void CloseMetadataModal()
    {
        _showMetadataModal = false;
    }

    // Display helper methods
    private static string GetTagDisplayName(NoteTag tag) => tag switch
    {
        NoteTag.None => "No Tag",
        NoteTag.Red => "Red",
        NoteTag.Orange => "Orange",
        NoteTag.Yellow => "Yellow",
        NoteTag.Green => "Green",
        NoteTag.Blue => "Blue",
        NoteTag.Purple => "Purple",
        _ => tag.ToString()
    };

    private static string GetNoteTagClass(NoteTag tag) => $"tag-{tag.ToString().ToLowerInvariant()}";

    private static string GetNoteTypeClass(NoteType type) => type.ToString().ToLowerInvariant();

    private static string GetFormatDisplayName(NoteFormat format) => format switch
    {
        NoteFormat.PlainText => "Plain Text",
        NoteFormat.Markdown => "Markdown",
        NoteFormat.RichText => "Rich Text",
        _ => format.ToString()
    };

    private static string GetFormatIcon(NoteFormat format) => format switch
    {
        NoteFormat.PlainText => "txt",
        NoteFormat.Markdown => "md",
        NoteFormat.RichText => "rtf",
        _ => "txt"
    };

    private static string GetTaskStatusDisplayName(NoteTaskStatus status) => status switch
    {
        NoteTaskStatus.NotStarted => "Not Started",
        NoteTaskStatus.InProgress => "In Progress",
        NoteTaskStatus.Completed => "Completed",
        _ => status.ToString()
    };

    private static string GetTaskStatusIcon(NoteTaskStatus status) => status switch
    {
        NoteTaskStatus.NotStarted => "bi-hourglass",
        NoteTaskStatus.InProgress => "bi-arrow-repeat",
        NoteTaskStatus.Completed => "bi-check-circle",
        _ => "bi-clipboard"
    };

    private static string GetTaskStatusClass(NoteTaskStatus status) => status switch
    {
        NoteTaskStatus.NotStarted => "status-not-started",
        NoteTaskStatus.InProgress => "status-in-progress",
        NoteTaskStatus.Completed => "status-completed",
        _ => ""
    };

    private static string GetIdeaStageDisplayName(IdeaStage stage) => stage switch
    {
        IdeaStage.Seed => "Seed",
        IdeaStage.Exploring => "Exploring",
        IdeaStage.Validating => "Validating",
        IdeaStage.ReadyToBuild => "Ready To Build",
        _ => stage.ToString()
    };

    private static string GetRecurrenceIcon(RecurrencePattern recurrence) => recurrence switch
    {
        RecurrencePattern.Daily => "bi-arrow-repeat",
        RecurrencePattern.Weekly => "bi-calendar-week",
        RecurrencePattern.Monthly => "bi-calendar-month",
        _ => string.Empty
    };

    private static string GetRecurrenceDisplayName(RecurrencePattern recurrence) => recurrence switch
    {
        RecurrencePattern.Daily => "Daily Recurrence",
        RecurrencePattern.Weekly => "Weekly Recurrence",
        RecurrencePattern.Monthly => "Monthly Recurrence",
        _ => string.Empty
    };

    private static string GetHistoryContentPreview(string content)
    {
        if (string.IsNullOrWhiteSpace(content))
            return "(No content)";

        const int maxLength = 180;
        var compact = content.Replace("\r", " ").Replace("\n", " ").Trim();
        return compact.Length <= maxLength ? compact : compact[..maxLength] + "...";
    }

    private string GetLocationDisplay()
    {
        if (IsTrashNote)
        {
            return $"<span class='trash-indicator'><span class='bi bi-trash' aria-hidden='true'></span> Trash</span>";
        }
        return string.IsNullOrEmpty(_currentFolder) ? "Root" : _currentFolder;
    }
}
