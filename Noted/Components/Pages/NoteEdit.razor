@page "/note/new"
@page "/note/edit/{NoteTitle}"
@using BusinessLogic.Features.Notes
@using BusinessLogic.Features.NoteTemplates
@using BusinessLogic.Models.Notes
@using BusinessLogic.Shared
@using Noted.Services
@inject INoteManagement NoteManager
@inject INoteTemplateManagement TemplateManager
@inject INotificationService NotificationService
@inject SidebarService SidebarService
@inject MarkdownService MarkdownService
@inject NavigationManager Navigation

<div class="note-edit-container">
    <header class="note-edit-header">
        <div class="header-icon">
            <span class="bi @(IsEditMode ? "bi-pencil-square" : "bi-plus-circle")" aria-hidden="true"></span>
        </div>
        <div class="header-text">
            <h1>@(IsEditMode ? "Edit Note" : "Create New Note")</h1>
            <p class="header-subtitle">@(IsEditMode ? "Make changes to your note" : "Capture your thoughts and ideas")</p>
        </div>
        @if (IsEditMode)
        {
            <button class="btn btn-outline-secondary btn-view" @onclick="HandleViewNote" title="View formatted note">
                <span class="bi bi-eye" aria-hidden="true"></span> View
            </button>
        }
    </header>

    <div class="note-edit-form">
        @* Title input - required field *@
        <div class="form-group">
            <label class="form-label">Title</label>
            <input type="text" @bind="Title" placeholder="Enter note title..." class="form-control title-input" />
        </div>

        @* Note type selector - determines which additional fields to show *@
        <div class="form-row">
            <div class="form-group flex-1">
                <label class="form-label">Note Type</label>
                <select @bind="NoteType" class="form-select">
                    @foreach (var type in Enum.GetValues<NoteType>())
                    {
                        <option value="@type">@type</option>
                    }
                </select>
            </div>

            @* Content format selector *@
            <div class="form-group flex-1">
                <label class="form-label">Content Format</label>
                <select @bind="Format" class="form-select">
                    @foreach (var format in Enum.GetValues<NoteFormat>())
                    {
                        <option value="@format">@GetFormatDisplayName(format)</option>
                    }
                </select>
            </div>
        </div>

        @if (!IsEditMode)
        {
            <div class="template-panel">
                <div class="template-header-row">
                    <label class="form-label">Templates</label>
                    <span class="template-hint">Apply a template or save this note as one</span>
                </div>

                <div class="template-actions-row">
                    <select @bind="_selectedTemplateName" class="form-select flex-1">
                        <option value="">Select a template...</option>
                        @foreach (var template in _templates)
                        {
                            <option value="@template.Name">@template.Name</option>
                        }
                    </select>
                    <button class="btn btn-secondary" @onclick="ApplySelectedTemplate" disabled="@string.IsNullOrWhiteSpace(_selectedTemplateName)">Apply</button>
                    <button class="btn btn-outline-danger" @onclick="DeleteSelectedTemplate" disabled="@string.IsNullOrWhiteSpace(_selectedTemplateName)">Delete</button>
                </div>

                <div class="template-actions-row">
                    <input type="text"
                           @bind="_templateName"
                           @bind:event="oninput"
                           placeholder="Template name (for example: Meeting Notes)"
                           class="form-control flex-1" />
                    <button class="btn btn-outline-primary" @onclick="SaveCurrentAsTemplate" disabled="@string.IsNullOrWhiteSpace(_templateName)">Save as Template</button>
                </div>

                @if (!string.IsNullOrWhiteSpace(_templateMessage))
                {
                    <div class="template-status @(_isTemplateError ? "error" : "success")">@_templateMessage</div>
                }
            </div>
        }

        @* Reminder-specific: Date/time picker and recurrence selector *@
        @if (NoteType == NoteType.Reminder)
        {
            <div class="form-group">
                <label class="form-label">Reminder Date & Time</label>
                <input type="datetime-local"
                       @bind="ReminderDateTime"
                       min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
                       class="form-control" />
            </div>
            <div class="form-group">
                <label class="form-label">Recurrence</label>
                <select @bind="Recurrence" class="form-select">
                    @foreach (var pattern in Enum.GetValues<RecurrencePattern>())
                    {
                        <option value="@pattern">@pattern</option>
                    }
                </select>
            </div>
        }

        @* Task-specific: Status selector *@
        @if (NoteType == NoteType.Task)
        {
            <div class="form-group">
                <label class="form-label">Status</label>
                <select @bind="TaskStatus" class="form-select">
                    @foreach (var status in Enum.GetValues<NoteTaskStatus>())
                    {
                        <option value="@status">@GetTaskStatusDisplayName(status)</option>
                    }
                </select>
            </div>
        }

        @* Idea-specific: Stage selector and guided next step *@
        @if (NoteType == NoteType.Idea)
        {
            <div class="form-group">
                <label class="form-label">Idea Stage</label>
                <select @bind="IdeaStage" class="form-select">
                    @foreach (var stage in Enum.GetValues<IdeaStage>())
                    {
                        <option value="@stage">@GetIdeaStageDisplayName(stage)</option>
                    }
                </select>
                <small class="form-hint">@GetIdeaFocusPrompt(IdeaStage)</small>
            </div>
        }

        @* Color tag selector - visual categorization *@
        <div class="form-group">
            <label class="form-label">Color Tag</label>
            <div class="tag-options">
                @foreach (var tag in Enum.GetValues<NoteTag>())
                {
                    <button type="button"
                            class="tag-option @GetNoteTagClass(tag) @(Tag == tag ? "selected" : "")"
                            @onclick="() => Tag = tag"
                            title="@GetTagDisplayName(tag)">
                        @if (tag == NoteTag.None)
                        {
                            <span class="bi bi-slash-circle" aria-hidden="true"></span>
                        }
                    </button>
                }
            </div>
        </div>

        @* Content editor section with optional preview *@
        <div class="form-group content-group @(_isExpanded ? "expanded" : "")">
            <div class="content-header">
                <label class="form-label">Content</label>
                @if (Format == NoteFormat.Markdown)
                {
                    <div class="preview-toggle">
                        <button type="button" 
                                class="btn-toggle @(_showPreview ? "" : "active")" 
                                @onclick="() => _showPreview = false">
                            Edit
                        </button>
                        <button type="button" 
                                class="btn-toggle @(_showPreview ? "active" : "")" 
                                @onclick="() => _showPreview = true">
                            Preview
                        </button>
                    </div>
                }
                <button type="button" 
                        class="btn-expand" 
                        @onclick="() => _isExpanded = !_isExpanded" 
                        title="@(_isExpanded ? "Collapse editor" : "Expand editor")">
                    <span class="bi @(_isExpanded ? "bi-arrows-angle-contract" : "bi-arrows-angle-expand")" aria-hidden="true"></span>
                </button>
                @if (Format == NoteFormat.Markdown && !_showPreview)
                {
                    <span class="format-hint">Supports Markdown syntax</span>
                }
            </div>
            
            @if (Format == NoteFormat.Markdown && _showPreview)
            {
                @* Markdown preview pane *@
                <div class="content-preview markdown-preview">
                    @if (string.IsNullOrWhiteSpace(Content))
                    {
                        <p class="preview-placeholder">Start typing to see preview...</p>
                    }
                    else
                    {
                        @((MarkupString)MarkdownService.ToHtml(Content))
                    }
                </div>
            }
            else
            {
                @* Text editor *@
                <textarea @bind="Content" 
                          @bind:event="oninput"
                          placeholder="@GetContentPlaceholder()" 
                          class="form-control content-textarea"></textarea>
            }
        </div>

        @* Validation message *@
        @if (_showValidationError)
        {
            <div class="validation-error">
                Please enter both a title and content for your note.
            </div>
        }

        @* Action buttons *@
        <div class="form-actions">
            <button class="btn btn-secondary" @onclick="HandleCancel">Cancel</button>
            <button class="btn btn-primary" @onclick="HandleSave">@(IsEditMode ? "Save Changes" : "Create Note")</button>
        </div>
    </div>
</div>

@code {
    // Route parameter for editing existing notes
    [Parameter] public string? NoteTitle { get; set; }

    // Form state
    private string Title { get; set; } = string.Empty;
    private string Content { get; set; } = string.Empty;
    private NoteType NoteType { get; set; } = NoteType.General;
    private NoteTag Tag { get; set; } = NoteTag.None;
    private NoteFormat Format { get; set; } = NoteFormat.PlainText;
    private DateTime? ReminderDateTime { get; set; }
    private RecurrencePattern Recurrence { get; set; } = RecurrencePattern.None;
    private NoteTaskStatus TaskStatus { get; set; } = NoteTaskStatus.NotStarted;
    private IdeaStage IdeaStage { get; set; } = IdeaStage.Seed;

    // UI state
    private bool _showPreview;
    private bool _isExpanded;
    private List<NoteTemplate> _templates = [];
    private string _selectedTemplateName = string.Empty;
    private string _templateName = string.Empty;
    private string _templateMessage = string.Empty;
    private bool _isTemplateError;

    // Original note reference for editing
    private Note? _originalNote;
    private string _originalTitle = string.Empty;
    private bool _showValidationError;

    private bool IsEditMode => !string.IsNullOrEmpty(NoteTitle);

    protected override async Task OnInitializedAsync()
    {
        await LoadTemplatesAsync();

        if (IsEditMode && !string.IsNullOrEmpty(NoteTitle))
        {
            await LoadExistingNoteAsync();
        }
    }

    private async Task LoadTemplatesAsync()
    {
        _templates = (await TemplateManager.GetTemplatesAsync()).ToList();
    }

    private async Task LoadExistingNoteAsync()
    {
        var decodedTitle = Uri.UnescapeDataString(NoteTitle!);
        var notes = await NoteManager.RetrieveNotesAsync(SidebarService.CurrentFolder);
        _originalNote = notes.FirstOrDefault(n => n.Title == decodedTitle);

        if (_originalNote is not null)
        {
            _originalTitle = _originalNote.Title;
            Title = _originalNote.Title;
            Content = _originalNote.Content;
            NoteType = _originalNote.Type;
            Tag = _originalNote.Tag;
            Format = _originalNote.Format;

            if (_originalNote is ReminderNote reminderNote)
            {
                ReminderDateTime = reminderNote.ReminderDateTime;
                Recurrence = reminderNote.Recurrence;
            }
            else if (_originalNote is TaskNote taskNote)
            {
                TaskStatus = taskNote.Status;
            }
            else if (_originalNote is IdeaNote ideaNote)
            {
                IdeaStage = ideaNote.Stage;
            }
        }
        else
        {
            // Note not found, navigate back
            Navigation.NavigateTo("/");
        }
    }

    private void HandleViewNote()
    {
        if (_originalNote is not null)
        {
            var encodedTitle = Uri.EscapeDataString(_originalNote.Title);
            Navigation.NavigateTo($"/note/view/{encodedTitle}");
        }
    }

    private async Task HandleSave()
    {
        // Validate required fields
        if (string.IsNullOrWhiteSpace(Title) || string.IsNullOrWhiteSpace(Content))
        {
            _showValidationError = true;
            return;
        }

        _showValidationError = false;
        DateTime? reminderDateTime = NoteType == NoteType.Reminder ? ReminderDateTime : null;
        var currentFolder = SidebarService.CurrentFolder;

        if (IsEditMode && _originalNote is not null)
        {
            // Update existing note
            var updatedNote = CreateNote(NoteType, Title, Content, _originalNote.CreatedAt, DateTime.Now, reminderDateTime, TaskStatus, IdeaStage, Tag, Format, _originalNote.IsPinned, Recurrence);

            await NoteManager.UpdateNoteAsync(_originalTitle, updatedNote, currentFolder);

            // Handle notification updates for reminders
            await NotificationService.CancelNotificationAsync($"reminder_{_originalTitle}");
            if (reminderDateTime.HasValue && reminderDateTime.Value > DateTime.Now)
            {
                await NotificationService.ScheduleNotificationAsync(
                    $"reminder_{Title}",
                    $"Reminder: {Title}",
                    Content,
                    reminderDateTime.Value);
            }
        }
        else
        {
            // Create new note
            var note = CreateNote(NoteType, Title, Content, DateTime.Now, DateTime.Now, reminderDateTime, TaskStatus, IdeaStage, Tag, Format);

            await NoteManager.SaveNoteAsync(note, currentFolder);

            // Schedule notification for new reminders
            if (reminderDateTime.HasValue && reminderDateTime.Value > DateTime.Now)
            {
                await NotificationService.ScheduleNotificationAsync(
                    $"reminder_{Title}",
                    $"Reminder: {Title}",
                    Content,
                    reminderDateTime.Value);
            }
        }

        // Notify sidebar to refresh notes list
        SidebarService.NotifyNotesChanged();

        // Navigate back to notes list
        Navigation.NavigateTo("/");
    }

    private void ApplySelectedTemplate()
    {
        if (string.IsNullOrWhiteSpace(_selectedTemplateName))
            return;

        var template = _templates.FirstOrDefault(t => t.Name.Equals(_selectedTemplateName, StringComparison.OrdinalIgnoreCase));
        if (template is null)
        {
            _templateMessage = "Template was not found.";
            _isTemplateError = true;
            return;
        }

        Title = template.Title;
        Content = template.Content;
        NoteType = template.NoteType;
        Tag = template.Tag;
        Format = template.Format;
        Recurrence = template.Recurrence;
        TaskStatus = template.TaskStatus;
        IdeaStage = template.IdeaStage;
        ReminderDateTime = null;
        _showPreview = false;

        _templateMessage = $"Applied template: {template.Name}";
        _isTemplateError = false;
    }

    private async Task SaveCurrentAsTemplate()
    {
        if (string.IsNullOrWhiteSpace(_templateName))
        {
            _templateMessage = "Template name is required.";
            _isTemplateError = true;
            return;
        }

        if (string.IsNullOrWhiteSpace(Content))
        {
            _templateMessage = "Add content before saving a template.";
            _isTemplateError = true;
            return;
        }

        var template = new NoteTemplate
        {
            Name = _templateName.Trim(),
            Title = string.IsNullOrWhiteSpace(Title) ? "Untitled" : Title.Trim(),
            Content = Content,
            NoteType = NoteType,
            Tag = Tag,
            Format = Format,
            Recurrence = Recurrence,
            TaskStatus = TaskStatus,
            IdeaStage = IdeaStage
        };

        var result = await TemplateManager.SaveTemplateAsync(template);
        if (!result.Success)
        {
            _templateMessage = result.ErrorMessage ?? "Failed to save template.";
            _isTemplateError = true;
            return;
        }

        _selectedTemplateName = template.Name;
        _templateName = string.Empty;
        _templateMessage = "Template saved.";
        _isTemplateError = false;
        await LoadTemplatesAsync();
    }

    private async Task DeleteSelectedTemplate()
    {
        if (string.IsNullOrWhiteSpace(_selectedTemplateName))
            return;

        var result = await TemplateManager.DeleteTemplateAsync(_selectedTemplateName);
        if (!result.Success)
        {
            _templateMessage = result.ErrorMessage ?? "Failed to delete template.";
            _isTemplateError = true;
            return;
        }

        _templateMessage = $"Deleted template: {_selectedTemplateName}";
        _isTemplateError = false;
        _selectedTemplateName = string.Empty;
        await LoadTemplatesAsync();
    }

    private void HandleCancel()
    {
        Navigation.NavigateTo("/");
    }

    /// <summary>
    /// Factory method to create the appropriate Note subclass based on type.
    /// </summary>
    private static Note CreateNote(NoteType noteType, string title, string content, DateTime createdAt, DateTime modifiedAt, DateTime? reminderDateTime, NoteTaskStatus taskStatus, IdeaStage ideaStage, NoteTag tag, NoteFormat format, bool isPinned = false, RecurrencePattern recurrence = RecurrencePattern.None)
    {
        return noteType switch
        {
            NoteType.General => new GeneralNote
            {
                Title = title,
                Content = content,
                CreatedAt = createdAt,
                ModifiedAt = modifiedAt,
                IsPinned = isPinned,
                Tag = tag,
                Format = format
            },
            NoteType.Reminder => new ReminderNote
            {
                Title = title,
                Content = content,
                CreatedAt = createdAt,
                ModifiedAt = modifiedAt,
                IsPinned = isPinned,
                Tag = tag,
                Format = format,
                ReminderDateTime = reminderDateTime ?? DateTime.MinValue,
                Recurrence = recurrence
            },
            NoteType.Task => new TaskNote
            {
                Title = title,
                Content = content,
                CreatedAt = createdAt,
                ModifiedAt = modifiedAt,
                IsPinned = isPinned,
                Tag = tag,
                Format = format,
                Status = taskStatus
            },
            NoteType.Idea => new IdeaNote
            {
                Title = title,
                Content = content,
                CreatedAt = createdAt,
                ModifiedAt = modifiedAt,
                IsPinned = isPinned,
                Tag = tag,
                Format = format,
                Stage = ideaStage
            },
            _ => throw new InvalidOperationException($"Unknown note type: {noteType}")
        };
    }

    private static string GetIdeaStageDisplayName(IdeaStage stage) => stage switch
    {
        IdeaStage.Seed => "Seed",
        IdeaStage.Exploring => "Exploring",
        IdeaStage.Validating => "Validating",
        IdeaStage.ReadyToBuild => "Ready To Build",
        _ => stage.ToString()
    };

    private static string GetIdeaFocusPrompt(IdeaStage stage) => stage switch
    {
        IdeaStage.Seed => "Describe the core problem this idea solves.",
        IdeaStage.Exploring => "Compare possible approaches and trade-offs.",
        IdeaStage.Validating => "Define a lightweight experiment to test it.",
        IdeaStage.ReadyToBuild => "Outline the first milestone and success criteria.",
        _ => string.Empty
    };

    // Helper methods for display formatting
    private static string GetTagDisplayName(NoteTag tag) => tag switch
    {
        NoteTag.None => "No Tag",
        NoteTag.Red => "Red (High Priority)",
        NoteTag.Orange => "Orange",
        NoteTag.Yellow => "Yellow",
        NoteTag.Green => "Green",
        NoteTag.Blue => "Blue",
        NoteTag.Purple => "Purple",
        _ => tag.ToString()
    };

    private static string GetNoteTagClass(NoteTag tag) => $"tag-{tag.ToString().ToLowerInvariant()}";

    private static string GetTaskStatusDisplayName(NoteTaskStatus status) => status switch
    {
        NoteTaskStatus.NotStarted => "Not Started",
        NoteTaskStatus.InProgress => "In Progress",
        NoteTaskStatus.Completed => "Completed",
        _ => status.ToString()
    };

    private static string GetFormatDisplayName(NoteFormat format) => format switch
    {
        NoteFormat.PlainText => "Plain Text (.txt)",
        NoteFormat.Markdown => "Markdown (.md)",
        NoteFormat.RichText => "Rich Text (.rtf)",
        _ => format.ToString()
    };

    private string GetContentPlaceholder() => Format switch
    {
        NoteFormat.Markdown => "Write your note using Markdown...\n\n# Heading\n**Bold** and *italic* text\n- Bullet points\n1. Numbered lists\n> Blockquotes\n`code`",
        _ => "Write your note here..."
    };
}
