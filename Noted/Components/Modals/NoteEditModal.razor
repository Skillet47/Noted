@using BusinessLogic.Core
@using BusinessLogic.Notes

<div class="modal-backdrop" @onclick="OnCancel"></div>
<div class="modal-container">
    <div class="modal-dialog">
        <div class="modal-header">
            <h5 class="modal-title">@(IsEditMode ? "Edit Note" : "Add New Note")</h5>
        </div>
        <div class="modal-body">
            <input type="text" @bind="Title" placeholder="Note title..." class="form-control mb-2" />
            <textarea @bind="Content" placeholder="Write your note here..." class="form-control mb-2" rows="3"></textarea>
            <select @bind="NoteType" class="form-select mb-2">
                @foreach (var type in Enum.GetValues<NoteType>())
                {
                    <option value="@type">@type</option>
                }
            </select>
            <div class="tag-selector mb-2">
                <label class="form-label">Color Tag</label>
                <div class="tag-options">
                    @foreach (var tag in Enum.GetValues<NoteTag>())
                    {
                        <button type="button"
                                class="tag-option @GetNoteTagClass(tag) @(Tag == tag ? "selected" : "")"
                                @onclick="() => Tag = tag"
                                title="@GetTagDisplayName(tag)">
                            @if (tag == NoteTag.None)
                            {
                                <span>?</span>
                            }
                        </button>
                    }
                </div>
            </div>
            @if (NoteType == NoteType.Reminder)
            {
                <div class="reminder-datetime-container">
                    <label class="form-label">Reminder Date & Time</label>
                    <input type="datetime-local"
                           @bind="ReminderDateTime"
                           min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
                           class="form-control" />
                </div>
            }
            @if (NoteType == NoteType.Task)
            {
                <div class="task-status-container">
                    <label class="form-label">Status</label>
                    <select @bind="TaskStatus" class="form-select">
                        @foreach (var status in Enum.GetValues<NoteTaskStatus>())
                        {
                            <option value="@status">@GetTaskStatusDisplayName(status)</option>
                        }
                    </select>
                </div>
            }
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" @onclick="OnCancel">Cancel</button>
            <button class="btn btn-primary" @onclick="HandleSave">@(IsEditMode ? "Save Changes" : "Add Note")</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool IsEditMode { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Content { get; set; } = string.Empty;
    [Parameter] public NoteType NoteType { get; set; } = NoteType.Idea;
    [Parameter] public NoteTag Tag { get; set; } = NoteTag.None;
    [Parameter] public DateTime? ReminderDateTime { get; set; }
    [Parameter] public NoteTaskStatus TaskStatus { get; set; } = NoteTaskStatus.NotStarted;
    [Parameter] public EventCallback<NoteEditResult> OnSave { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task HandleSave()
    {
        if (string.IsNullOrWhiteSpace(Title) || string.IsNullOrWhiteSpace(Content))
            return;

        var result = new NoteEditResult
        {
            Title = Title,
            Content = Content,
            NoteType = NoteType,
            Tag = Tag,
            ReminderDateTime = NoteType == NoteType.Reminder ? ReminderDateTime : null,
            TaskStatus = TaskStatus
        };

        await OnSave.InvokeAsync(result);
    }

    private async Task OnCancel()
    {
        await OnClose.InvokeAsync();
    }

    private static string GetTagDisplayName(NoteTag tag) => tag switch
    {
        NoteTag.None => "No Tag",
        NoteTag.Red => "Red (High Priority)",
        NoteTag.Orange => "Orange",
        NoteTag.Yellow => "Yellow",
        NoteTag.Green => "Green",
        NoteTag.Blue => "Blue",
        NoteTag.Purple => "Purple",
        _ => tag.ToString()
    };

    private static string GetNoteTagClass(NoteTag tag) => $"tag-{tag.ToString().ToLowerInvariant()}";

    private static string GetTaskStatusDisplayName(NoteTaskStatus status) => status switch
    {
        NoteTaskStatus.NotStarted => "Not Started",
        NoteTaskStatus.InProgress => "In Progress",
        NoteTaskStatus.Completed => "Completed",
        _ => status.ToString()
    };

    public class NoteEditResult
    {
        public string Title { get; set; } = string.Empty;
        public string Content { get; set; } = string.Empty;
        public NoteType NoteType { get; set; }
        public NoteTag Tag { get; set; }
        public DateTime? ReminderDateTime { get; set; }
        public NoteTaskStatus TaskStatus { get; set; }
    }
}
