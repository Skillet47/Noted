@using BusinessLogic.Notes

<div class="modal-backdrop" @onclick="OnCancel"></div>
<div class="modal-container">
    <div class="modal-dialog">
        <div class="modal-header">
            <h5 class="modal-title">Confirm Delete</h5>
        </div>
        <div class="modal-body">
            <p>Are you sure you want to delete "<strong>@NoteTitle</strong>"?</p>
            <p class="text-muted">This action cannot be undone.</p>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" @onclick="OnCancel">Cancel</button>
            <button class="btn btn-danger" @onclick="HandleConfirm">Delete</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public string? NoteTitle { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task HandleConfirm()
    {
        await OnConfirm.InvokeAsync();
    }

    private async Task OnCancel()
    {
        await OnClose.InvokeAsync();
    }
}
