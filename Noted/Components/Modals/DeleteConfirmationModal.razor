@using BusinessLogic.Notes

@* Modal backdrop - clicking closes the modal *@
<div class="modal-backdrop" @onclick="OnCancel"></div>
<div class="modal-container">
    <div class="modal-dialog">
        <div class="modal-header">
            <h5 class="modal-title">Confirm Delete</h5>
        </div>
        <div class="modal-body">
            <p>Are you sure you want to delete "<strong>@Title</strong>"?</p>
            <p class="text-muted">This action cannot be undone.</p>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" @onclick="OnCancel">Cancel</button>
            <button class="btn btn-danger" @onclick="HandleConfirm">Delete</button>
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// The title of the note or folder being deleted. Displayed in the confirmation message.
    /// </summary>
    [Parameter] public string? Title { get; set; }
    
    /// <summary>
    /// Callback invoked when the user confirms the deletion.
    /// </summary>
    [Parameter] public EventCallback OnConfirm { get; set; }
    
    /// <summary>
    /// Callback invoked when the user cancels or closes the modal.
    /// </summary>
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task HandleConfirm()
    {
        await OnConfirm.InvokeAsync();
    }

    private async Task OnCancel()
    {
        await OnClose.InvokeAsync();
    }
}
