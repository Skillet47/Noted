@*
    NavMenu.razor
    Obsidian-style sidebar with notes displayed in a tree view.
    
    Features:
    - Pinned notes section at the top
    - Folder tree with notes inside each folder
    - Note type color indicators
    - Click to view note, edit from view page
*@
@using BusinessLogic.Core
@using Noted.Services
@inject INoteManagement NoteManager
@inject NavigationManager Navigation
@inject SidebarService SidebarService
@implements IDisposable

<div class="sidebar-container">
    @* Sidebar header with app name *@
    <div class="sidebar-header">
        <span class="vault-name">Noted</span>
    </div>

    @* Quick actions bar *@
    <div class="sidebar-actions">
        <button class="action-btn" @onclick="NavigateToNewNote" title="New note">
            <span class="bi bi-plus-lg action-icon" aria-hidden="true"></span>
            <span class="action-text">New note</span>
        </button>
        <button class="action-btn" @onclick="ShowNewFolderInput" title="New folder">
            <span class="bi bi-folder-plus action-icon" aria-hidden="true"></span>
            <span class="action-text">New folder</span>
        </button>
    </div>

    @* New folder input *@
    @if (_showNewFolderInput)
    {
        <div class="new-folder-input">
            <input type="text" 
                   @bind="_newFolderName" 
                   @bind:event="oninput"
                   @onkeydown="OnFolderInputKeyDown"
                   placeholder="Folder name..." 
                   class="folder-input" />
            <div class="folder-input-actions">
                <button class="input-btn confirm" @onclick="CreateFolder" title="Create"><span class="bi bi-check-lg" aria-hidden="true"></span></button>
                <button class="input-btn cancel" @onclick="CancelNewFolder" title="Cancel"><span class="bi bi-x-lg" aria-hidden="true"></span></button>
            </div>
        </div>
    }

    @* File explorer with notes *@
    <div class="file-explorer">
        @* Pinned notes section *@
        @if (_pinnedNotes.Any())
        {
            <div class="explorer-section">
                <div class="section-header" @onclick="TogglePinnedSection">
                    <span class="bi @(_pinnedExpanded ? "bi-chevron-down" : "bi-chevron-right") collapse-icon" aria-hidden="true"></span>
                    <span class="bi bi-pin-angle section-icon" aria-hidden="true"></span>
                    <span class="section-title">PINNED</span>
                    <span class="section-count">@_pinnedNotes.Count</span>
                </div>
                @if (_pinnedExpanded)
                {
                    <nav class="explorer-items">
                        @foreach (var note in _pinnedNotes)
                        {
                            <div class="note-row @(SidebarService.SelectedNoteTitle == note.Title ? "selected" : "")">
                                <a class="explorer-item note-item" 
                                   @onclick="() => SelectPinnedNote(note)" @onclick:preventDefault>
                                    <span class="note-type-indicator @GetNoteTypeClass(note.Type)"></span>
                                    <span class="item-text">@note.Title</span>
                                </a>
                                <button class="note-pin-btn pinned" 
                                        @onclick="() => UnpinFromPinnedSection(note)" 
                                        @onclick:stopPropagation="true"
                                        title="Unpin">
                                    <span class="bi bi-pin-angle-fill" aria-hidden="true"></span>
                                </button>
                            </div>
                        }
                    </nav>
                }
            </div>
        }

        @* Root notes (not in any folder) *@
        <div class="explorer-section">
            <div class="section-header" @onclick="ToggleRootNotesSection">
                <span class="bi @(_rootNotesExpanded ? "bi-chevron-down" : "bi-chevron-right") collapse-icon" aria-hidden="true"></span>
                <span class="bi bi-file-earmark-text section-icon" aria-hidden="true"></span>
                <span class="section-title">NOTES</span>
                <span class="section-count">@_rootNotes.Count</span>
            </div>
            @if (_rootNotesExpanded)
            {
                <nav class="explorer-items">
                    @foreach (var note in _rootNotes)
                    {
                        <div class="note-row @(SidebarService.SelectedNoteTitle == note.Title ? "selected" : "")">
                            <a class="explorer-item note-item" 
                               @onclick="() => SelectNote(note)" @onclick:preventDefault>
                                <span class="note-type-indicator @GetNoteTypeClass(note.Type)"></span>
                                <span class="item-text">@note.Title</span>
                            </a>
                            @if (note.IsPinned)
                            {
                                <span class="note-pin-btn pinned" title="Pinned">
                                    <span class="bi bi-pin-angle-fill" aria-hidden="true"></span>
                                </span>
                            }
                            else
                            {
                                <button class="note-pin-btn" 
                                        @onclick="() => TogglePin(note)" 
                                        @onclick:stopPropagation="true"
                                        title="Pin">
                                    <span class="bi bi-pin-angle" aria-hidden="true"></span>
                                </button>
                            }
                        </div>
                    }
                    @if (!_rootNotes.Any())
                    {
                        <span class="no-items">No notes yet</span>
                    }
                </nav>
            }
        </div>

        @* Folders with their notes *@
        @foreach (var folder in _folders)
        {
            var folderNotes = GetNotesForFolder(folder);
            var isFolderExpanded = _expandedFolders.Contains(folder);
            
            <div class="explorer-section folder-section">
                <div class="section-header folder-header" @onclick="() => ToggleFolderExpanded(folder)">
                    <span class="bi @(isFolderExpanded ? "bi-chevron-down" : "bi-chevron-right") collapse-icon" aria-hidden="true"></span>
                    <span class="bi bi-folder folder-icon" aria-hidden="true"></span>
                    <span class="section-title folder-name">@folder</span>
                    <span class="section-count">@folderNotes.Count</span>
                    <button class="folder-add-note-btn"
                            @onclick="() => NavigateToNewNoteInFolder(folder)"
                            @onclick:stopPropagation="true"
                            title="New note in folder">
                        <span class="bi bi-plus" aria-hidden="true"></span>
                    </button>
                    <button class="folder-delete-btn" 
                            @onclick="() => PromptDeleteFolder(folder)" 
                            @onclick:stopPropagation="true"
                            title="Delete folder">
                        <span class="bi bi-trash" aria-hidden="true"></span>
                    </button>
                </div>
                @if (isFolderExpanded)
                {
                    <nav class="explorer-items">
                        @foreach (var note in folderNotes)
                        {
                            <div class="note-row @(SidebarService.SelectedNoteTitle == note.Title ? "selected" : "")">
                                <a class="explorer-item note-item folder-note" 
                                   @onclick="() => SelectNoteInFolder(note, folder)" @onclick:preventDefault>
                                    <span class="note-type-indicator @GetNoteTypeClass(note.Type)"></span>
                                    <span class="item-text">@note.Title</span>
                                </a>
                                @if (note.IsPinned)
                                {
                                    <span class="note-pin-btn pinned" title="Pinned">
                                        <span class="bi bi-pin-angle-fill" aria-hidden="true"></span>
                                    </span>
                                }
                                else
                                {
                                    <button class="note-pin-btn" 
                                            @onclick="() => TogglePinInFolder(note, folder)" 
                                            @onclick:stopPropagation="true"
                                            title="Pin">
                                        <span class="bi bi-pin-angle" aria-hidden="true"></span>
                                    </button>
                                }
                            </div>
                        }
                        @if (!folderNotes.Any())
                        {
                            <span class="no-items">Empty folder</span>
                        }
                    </nav>
                }
            </div>
        }

        @* Trash section *@
        <div class="explorer-section trash-section">
            <div class="section-header" @onclick="ToggleTrashSection">
                <span class="bi @(_trashExpanded ? "bi-chevron-down" : "bi-chevron-right") collapse-icon" aria-hidden="true"></span>
                <span class="bi bi-trash section-icon" aria-hidden="true"></span>
                <span class="section-title">TRASH</span>
                <span class="section-count">@_trashNotes.Count</span>
            </div>
            @if (_trashExpanded)
            {
                <nav class="explorer-items">
                    @foreach (var note in _trashNotes)
                    {
                        <div class="note-row trash-note @(SidebarService.SelectedNoteTitle == note.Title ? "selected" : "")">
                            <a class="explorer-item note-item" 
                               @onclick="() => SelectTrashNote(note)" @onclick:preventDefault>
                                <span class="note-type-indicator @GetNoteTypeClass(note.Type)"></span>
                                <span class="item-text">@note.Title</span>
                            </a>
                        </div>
                    }
                    @if (!_trashNotes.Any())
                    {
                        <span class="no-items">Trash is empty</span>
                    }
                </nav>
            }
        </div>
    </div>

    @* Bottom section with settings *@
    <div class="sidebar-footer">
        <NavLink class="footer-item" href="settings">
            <span class="bi bi-gear item-icon" aria-hidden="true"></span>
            <span class="item-text">Settings</span>
        </NavLink>
    </div>
</div>

@* Delete folder confirmation *@
@if (_showDeleteConfirmation)
{
    <div class="delete-overlay" @onclick="CancelDeleteFolder">
        <div class="delete-dialog" @onclick:stopPropagation="true">
            <p>Delete folder "<strong>@_folderToDelete</strong>"?</p>
            <p class="delete-warning">Notes will be moved to trash.</p>
            <div class="delete-actions">
                <button class="btn-cancel" @onclick="CancelDeleteFolder">Cancel</button>
                <button class="btn-delete" @onclick="ConfirmDeleteFolder">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool SidebarCollapsed { get; set; }

    private const string TrashFolder = "Trash";
    
    // Folder state
    private List<string> _folders = [];
    private readonly HashSet<string> _expandedFolders = [];
    private bool _showNewFolderInput;
    private string _newFolderName = string.Empty;
    private bool _showDeleteConfirmation;
    private string? _folderToDelete;
    
    // Section expansion state
    private bool _pinnedExpanded = true;
    private bool _rootNotesExpanded = true;
    private bool _trashExpanded;
    
    // Notes cache
    private List<Note> _rootNotes = [];
    private List<Note> _pinnedNotes = [];
    private List<Note> _trashNotes = [];
    private readonly Dictionary<string, List<Note>> _folderNotesCache = new();
    private readonly Dictionary<string, string> _noteFolderMap = new(); // noteTitle -> subfolder

    protected override async Task OnInitializedAsync()
    {
        await LoadAllData();
        SidebarService.OnFoldersChanged += HandleDataChanged;
        SidebarService.OnNotesChanged += HandleDataChanged;
    }

    private async Task LoadAllData()
    {
        LoadFolders();
        await LoadAllNotes();
    }

    private void LoadFolders()
    {
        _folders = NoteManager.GetSubfolders()
            .Where(f => f != TrashFolder)
            .OrderBy(f => f, StringComparer.OrdinalIgnoreCase)
            .ToList();
        
        // Auto-expand folders with notes
        foreach (var folder in _folders)
        {
            _expandedFolders.Add(folder);
        }
    }

    private async Task LoadAllNotes()
    {
        // Load root notes
        _rootNotes = (await NoteManager.RetrieveNotesAsync(string.Empty))
            .OrderBy(n => n.Title, StringComparer.OrdinalIgnoreCase)
            .ToList();
        
        // Extract pinned notes from all folders
        _pinnedNotes = _rootNotes.Where(n => n.IsPinned).ToList();
        
        // Build folder map and load notes for each folder
        _folderNotesCache.Clear();
        _noteFolderMap.Clear();
        foreach (var note in _rootNotes)
            _noteFolderMap[note.Title] = string.Empty;
        
        foreach (var folder in _folders)
        {
            var notes = (await NoteManager.RetrieveNotesAsync(folder))
                .OrderBy(n => n.Title, StringComparer.OrdinalIgnoreCase)
                .ToList();
            _folderNotesCache[folder] = notes;
            
            // Add pinned notes from this folder
            _pinnedNotes.AddRange(notes.Where(n => n.IsPinned));
            
            foreach (var note in notes)
                _noteFolderMap[note.Title] = folder;
        }
        
        // Load trash notes
        _trashNotes = (await NoteManager.RetrieveNotesAsync(TrashFolder))
            .OrderBy(n => n.Title, StringComparer.OrdinalIgnoreCase)
            .ToList();
        
        // Sort pinned notes
        _pinnedNotes = _pinnedNotes.OrderBy(n => n.Title, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private List<Note> GetNotesForFolder(string folder)
    {
        return _folderNotesCache.TryGetValue(folder, out var notes) ? notes : new List<Note>();
    }

    private async void HandleDataChanged()
    {
        await LoadAllData();
        await InvokeAsync(StateHasChanged);
    }

    // Section toggles
    private void TogglePinnedSection() => _pinnedExpanded = !_pinnedExpanded;
    private void ToggleRootNotesSection() => _rootNotesExpanded = !_rootNotesExpanded;
    private void ToggleTrashSection() => _trashExpanded = !_trashExpanded;
    
    private void ToggleFolderExpanded(string folder)
    {
        if (_expandedFolders.Contains(folder))
            _expandedFolders.Remove(folder);
        else
            _expandedFolders.Add(folder);
    }

    // Note selection
    private void SelectNote(Note note)
    {
        SidebarService.CurrentFolder = string.Empty;
        SidebarService.SelectNote(note.Title);
        var encodedTitle = Uri.EscapeDataString(note.Title);
        Navigation.NavigateTo($"/note/view/{encodedTitle}");
    }

    private void SelectPinnedNote(Note note)
    {
        var folder = _noteFolderMap.TryGetValue(note.Title, out var f) ? f : string.Empty;
        SidebarService.CurrentFolder = folder;
        SidebarService.SelectNote(note.Title);
        var encodedTitle = Uri.EscapeDataString(note.Title);
        Navigation.NavigateTo($"/note/view/{encodedTitle}");
    }

    private void SelectNoteInFolder(Note note, string folder)
    {
        SidebarService.CurrentFolder = folder;
        SidebarService.SelectNote(note.Title);
        var encodedTitle = Uri.EscapeDataString(note.Title);
        Navigation.NavigateTo($"/note/view/{encodedTitle}");
    }

    private void SelectTrashNote(Note note)
    {
        SidebarService.CurrentFolder = TrashFolder;
        SidebarService.SelectNote(note.Title);
        var encodedTitle = Uri.EscapeDataString(note.Title);
        Navigation.NavigateTo($"/note/view/{encodedTitle}");
    }

    // Pin/unpin notes
    private async Task UnpinFromPinnedSection(Note note)
    {
        var folder = _noteFolderMap.TryGetValue(note.Title, out var f) ? f : string.Empty;
        note.IsPinned = false;
        await NoteManager.UpdateNoteAsync(note.Title, note, folder);
        await LoadAllNotes();
        SidebarService.NotifyNotesChanged();
    }

    private async Task TogglePin(Note note)
    {
        note.IsPinned = !note.IsPinned;
        await NoteManager.UpdateNoteAsync(note.Title, note, string.Empty);
        await LoadAllNotes();
        SidebarService.NotifyNotesChanged();
    }

    private async Task TogglePinInFolder(Note note, string folder)
    {
        note.IsPinned = !note.IsPinned;
        await NoteManager.UpdateNoteAsync(note.Title, note, folder);
        await LoadAllNotes();
        SidebarService.NotifyNotesChanged();
    }

    // New note
    private void NavigateToNewNote()
    {
        SidebarService.CurrentFolder = string.Empty;
        Navigation.NavigateTo("/note/new");
    }

    private void NavigateToNewNoteInFolder(string folder)
    {
        SidebarService.CurrentFolder = folder;
        Navigation.NavigateTo("/note/new");
    }

    // Folder operations
    private void ShowNewFolderInput()
    {
        _showNewFolderInput = true;
        _newFolderName = string.Empty;
    }

    private void CancelNewFolder()
    {
        _showNewFolderInput = false;
        _newFolderName = string.Empty;
    }

    private void OnFolderInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            CreateFolder();
        else if (e.Key == "Escape")
            CancelNewFolder();
    }

    private async void CreateFolder()
    {
        if (!string.IsNullOrWhiteSpace(_newFolderName))
        {
            if (NoteManager.CreateFolder(_newFolderName))
            {
                _expandedFolders.Add(_newFolderName);
                await LoadAllData();
                SidebarService.NotifyFoldersChanged();
            }
        }
        _showNewFolderInput = false;
        _newFolderName = string.Empty;
    }

    private void PromptDeleteFolder(string folder)
    {
        _folderToDelete = folder;
        _showDeleteConfirmation = true;
    }

    private void CancelDeleteFolder()
    {
        _folderToDelete = null;
        _showDeleteConfirmation = false;
    }

    private async Task ConfirmDeleteFolder()
    {
        if (!string.IsNullOrWhiteSpace(_folderToDelete))
        {
            if (await NoteManager.DeleteFolderAsync(_folderToDelete))
            {
                _expandedFolders.Remove(_folderToDelete);
                await LoadAllData();
                SidebarService.NotifyFoldersChanged();
                // Navigate to home if viewing a note from deleted folder
                Navigation.NavigateTo("/");
            }
        }
        CancelDeleteFolder();
    }

    // Helper methods
    private static string GetNoteTypeClass(NoteType type) => type switch
    {
        NoteType.Idea => "type-idea",
        NoteType.Reminder => "type-reminder",
        NoteType.Task => "type-task",
        _ => "type-idea"
    };

    public void Dispose()
    {
        SidebarService.OnFoldersChanged -= HandleDataChanged;
        SidebarService.OnNotesChanged -= HandleDataChanged;
    }
}
