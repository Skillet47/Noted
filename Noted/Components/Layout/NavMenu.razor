@*
    NavMenu.razor
    Obsidian-style sidebar with notes displayed in a tree view.
    
    Features:
    - Pinned notes section at the top
    - Folder tree with notes inside each folder
    - Note type color indicators
    - Click to view note, edit from view page
*@
@using BusinessLogic.Core
@using BusinessLogic.Features.Notes
@using BusinessLogic.Models.Notes
@using BusinessLogic.Shared
@using Noted.Services
@inject INoteManagement NoteManager
@inject NavigationManager Navigation
@inject SidebarService SidebarService
@inject FilterService FilterService
@inject IFilesPickerService FilesPickerService
@inject ImportExportService ImportExportService
@inject IFileExplorerService FileExplorerService
@implements IDisposable

<div class="sidebar-container">
    @* Quick actions bar *@
    <div class="sidebar-actions">
        <button class="action-btn" @onclick="NavigateToNewNote" title="New note">
            <span class="bi bi-plus-lg action-icon" aria-hidden="true"></span>
        </button>
        <button class="action-btn" @onclick="ShowNewFolderInput" title="New folder">
            <span class="bi bi-folder-plus action-icon" aria-hidden="true"></span>
        </button>
        <button class="action-btn @(_showImportOptions ? "active" : "")" @onclick="ToggleImportOptions" title="Import notes">
            <span class="bi bi-box-arrow-in-down action-icon" aria-hidden="true"></span>
        </button>
        <button class="action-btn @(_searchVisible || HasActiveFilters ? "active" : "")"
                @onclick="ToggleSearchVisible"
                title="@(_searchVisible ? "Hide search" : HasActiveFilters ? "Search (filters active)" : "Search")">
            <span class="bi bi-search action-icon" aria-hidden="true"></span>
        </button>
        @if (HasActiveFilters)
        {
            <button class="action-btn" @onclick="ClearAllFilters" title="Clear all filters">
                <span class="bi bi-funnel-fill action-icon" aria-hidden="true"></span>
            </button>
        }
    </div>

    @if (_showImportOptions)
    {
        <div class="import-actions-panel">
            <button class="import-option-btn" @onclick="ImportFileAsync" disabled="@_isImporting" title="Import a single file into root notes">
                @if (_isImporting)
                {
                    <span class="bi bi-arrow-repeat spin" aria-hidden="true"></span>
                    <span>Importing...</span>
                }
                else
                {
                    <span class="bi bi-file-earmark-arrow-down" aria-hidden="true"></span>
                    <span>Import File</span>
                }
            </button>
            <button class="import-option-btn" @onclick="ImportFolderAsync" disabled="@_isImporting" title="Import a folder into root notes">
                @if (_isImporting)
                {
                    <span class="bi bi-arrow-repeat spin" aria-hidden="true"></span>
                    <span>Importing...</span>
                }
                else
                {
                    <span class="bi bi-folder-arrow-down" aria-hidden="true"></span>
                    <span>Import Folder</span>
                }
            </button>
            @if (!string.IsNullOrWhiteSpace(_importStatusMessage))
            {
                <div class="import-status @(_importStatusError ? "error" : "success")">@_importStatusMessage</div>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_explorerStatusMessage))
    {
        <div class="import-actions-panel">
            <div class="import-status @(_explorerStatusError ? "error" : "success")">@_explorerStatusMessage</div>
        </div>
    }

    @if (_searchVisible)
    {
    <div class="sidebar-filters">
        <div class="filter-search-row">
            <span class="bi bi-search search-icon" aria-hidden="true"></span>
            <input type="text"
                   class="filter-input"
                   placeholder="Search notes and folders..."
                   value="@FilterService.SearchQuery"
                   @oninput="OnSearchChanged" />
            @if (!string.IsNullOrWhiteSpace(FilterService.SearchQuery))
            {
                <button class="clear-search-btn" @onclick="ClearSearch" title="Clear search">
                    <span class="bi bi-x" aria-hidden="true"></span>
                </button>
            }
            <button class="filter-toggle-btn @(HasActiveDropdownFilters ? "active" : "")" 
                    @onclick="ToggleFiltersExpanded"
                    title="@(_filtersExpanded ? "Hide filters" : "Show filters")">
                <span class="bi bi-funnel" aria-hidden="true"></span>
            </button>
        </div>
        <div class="filter-dropdowns @(_filtersExpanded ? "expanded" : "")">
            <select class="filter-select" value="@FilterService.FilterType" @onchange="OnTypeFilterChanged">
                <option value="">All note types</option>
                <option value="General">General</option>
                <option value="Idea">Ideas</option>
                <option value="Reminder">Reminders</option>
                <option value="Task">Tasks</option>
            </select>
            <select class="filter-select" value="@FilterService.SortOption" @onchange="OnSortOptionChanged">
                <option value="@SortOption.ModifiedNewest">@FilterService.GetSortOptionDisplayName(SortOption.ModifiedNewest)</option>
                <option value="@SortOption.ModifiedOldest">@FilterService.GetSortOptionDisplayName(SortOption.ModifiedOldest)</option>
                <option value="@SortOption.CreatedNewest">@FilterService.GetSortOptionDisplayName(SortOption.CreatedNewest)</option>
                <option value="@SortOption.CreatedOldest">@FilterService.GetSortOptionDisplayName(SortOption.CreatedOldest)</option>
                <option value="@SortOption.TitleAz">@FilterService.GetSortOptionDisplayName(SortOption.TitleAz)</option>
                <option value="@SortOption.TitleZa">@FilterService.GetSortOptionDisplayName(SortOption.TitleZa)</option>
            </select>
            <div class="tag-filter-row">
                @foreach (var tag in Enum.GetValues<NoteTag>().Where(t => t != NoteTag.None))
                {
                    var isActive = FilterService.FilterTag == tag.ToString();
                    <button class="tag-swatch @GetNoteTagClass(tag) @(isActive ? "tag-swatch-active" : "")"
                            @onclick="() => OnTagFilterChanged(tag)"
                            title="@GetTagDisplayName(tag)">
                    </button>
                }
                @if (!string.IsNullOrEmpty(FilterService.FilterTag))
                {
                    <button class="tag-swatch-clear" @onclick="ClearTagFilter" title="Clear tag filter">
                        <span class="bi bi-x" aria-hidden="true"></span>
                    </button>
                }
            </div>
        </div>
    </div>
    }

    @* New folder input *@
    @if (_showNewFolderInput)
    {
        <div class="new-folder-input">
            <input type="text" 
                   @bind="_newFolderName" 
                   @bind:event="oninput"
                   @onkeydown="OnFolderInputKeyDown"
                   placeholder="Folder name..." 
                   class="folder-input" />
            <div class="folder-input-actions">
                <button class="input-btn confirm" @onclick="CreateFolderAsync" title="Create"><span class="bi bi-check-lg" aria-hidden="true"></span></button>
                <button class="input-btn cancel" @onclick="CancelNewFolder" title="Cancel"><span class="bi bi-x-lg" aria-hidden="true"></span></button>
            </div>
        </div>
    }

    @* File explorer with notes *@
    <div class="file-explorer">
        @* Pinned notes section *@
        @if (_pinnedNotes.Any())
        {
            <div class="explorer-section">
                <div class="section-header" @onclick="TogglePinnedSection">
                    <span class="bi @(_pinnedExpanded ? "bi-chevron-down" : "bi-chevron-right") collapse-icon" aria-hidden="true"></span>
                    <span class="bi bi-pin-angle section-icon" aria-hidden="true"></span>
                    <span class="section-title">PINNED</span>
                    <span class="section-count">@_pinnedNotes.Count</span>
                </div>
                @if (_pinnedExpanded)
                {
                    <nav class="explorer-items">
                        @foreach (var note in _pinnedNotes)
                        {
                            <div class="note-row @(IsPinnedNoteSelected(note) ? "selected" : "")">
                                <a class="explorer-item note-item" 
                                   @onclick="() => SelectPinnedNote(note)" @onclick:preventDefault>
                                    <span class="note-type-indicator @GetNoteTypeClass(note.Type)"></span>
                                    @if (note.Tag != NoteTag.None)
                                    {
                                        <span class="bi bi-tag-fill note-tag-indicator @GetNoteTagClass(note.Tag)" title="@GetTagDisplayName(note.Tag)" aria-hidden="true"></span>
                                    }
                                    <span class="item-text">@note.Title</span>
                                </a>
                                <div class="note-actions">
                                    <button class="note-action-btn note-reveal-btn"
                                            @onclick="() => RevealNoteInExplorer(note, _noteFolderMap.TryGetValue(note.Title, out var folder) ? folder : string.Empty)"
                                            @onclick:stopPropagation="true"
                                            title="@GetRevealActionTitle()">
                                        <span class="bi bi-folder2-open" aria-hidden="true"></span>
                                    </button>
                                    <button class="note-action-btn note-pin-btn pinned" 
                                            @onclick="() => UnpinFromPinnedSection(note)" 
                                            @onclick:stopPropagation="true"
                                            title="Unpin">
                                        <span class="bi bi-pin-angle-fill" aria-hidden="true"></span>
                                    </button>
                                </div>
                            </div>
                        }
                    </nav>
                }
            </div>
        }

        @* Root notes (not in any folder) *@
        <div class="explorer-section">
            <div class="section-header" @onclick="ToggleRootNotesSection">
                <span class="bi @(_rootNotesExpanded ? "bi-chevron-down" : "bi-chevron-right") collapse-icon" aria-hidden="true"></span>
                <span class="bi bi-file-earmark-text section-icon" aria-hidden="true"></span>
                <span class="section-title">NOTES</span>
                <span class="section-count">@(_rootNotes.Count + _folders.Count)</span>
                <button class="section-collapse-btn"
                        @onclick="ToggleAllFoldersInNotesSection"
                        @onclick:stopPropagation="true"
                        title="@(AreAllFoldersInNotesSectionCollapsed ? "Expand all folders" : "Collapse all folders")">
                    <span class="bi @(AreAllFoldersInNotesSectionCollapsed ? "bi-arrows-expand" : "bi-arrows-collapse")" aria-hidden="true"></span>
                </button>
            </div>
            @if (_rootNotesExpanded)
            {
                <nav class="explorer-items">
                    @foreach (var note in _rootNotes)
                    {
                        <div class="note-row @(IsStandardNoteSelected(note, string.Empty) ? "selected" : "")">
                            <a class="explorer-item note-item" 
                               @onclick="() => SelectNote(note)" @onclick:preventDefault>
                                <span class="note-type-indicator @GetNoteTypeClass(note.Type)"></span>
                                @if (note.Tag != NoteTag.None)
                                {
                                    <span class="bi bi-tag-fill note-tag-indicator @GetNoteTagClass(note.Tag)" title="@GetTagDisplayName(note.Tag)" aria-hidden="true"></span>
                                }
                                <span class="item-text">@note.Title</span>
                            </a>
                            <div class="note-actions">
                                <button class="note-action-btn note-reveal-btn"
                                        @onclick="() => RevealNoteInExplorer(note, string.Empty)"
                                        @onclick:stopPropagation="true"
                                        title="@GetRevealActionTitle()">
                                    <span class="bi bi-folder2-open" aria-hidden="true"></span>
                                </button>
                                @if (note.IsPinned)
                                {
                                    <span class="note-action-btn note-pin-btn pinned" title="Pinned">
                                        <span class="bi bi-pin-angle-fill" aria-hidden="true"></span>
                                    </span>
                                }
                                else
                                {
                                    <button class="note-action-btn note-pin-btn" 
                                            @onclick="() => TogglePin(note)" 
                                            @onclick:stopPropagation="true"
                                            title="Pin">
                                        <span class="bi bi-pin-angle" aria-hidden="true"></span>
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    @* Folders with their notes (rendered under root NOTES tree) *@
                    @foreach (var folder in _folders)
                    {
                        var folderNotes = GetNotesForFolder(folder);
                        var isFolderExpanded = _expandedFolders.Contains(folder);
                        
                        <div class="explorer-section folder-section">
                            <div class="section-header folder-header" @onclick="() => ToggleFolderExpanded(folder)">
                                <span class="bi @(isFolderExpanded ? "bi-chevron-down" : "bi-chevron-right") collapse-icon" aria-hidden="true"></span>
                                <span class="bi bi-folder folder-icon" aria-hidden="true"></span>
                                <span class="section-title folder-name">@folder</span>
                                <span class="section-count">@folderNotes.Count</span>
                                <button class="folder-add-note-btn"
                                        @onclick="() => NavigateToNewNoteInFolder(folder)"
                                        @onclick:stopPropagation="true"
                                        title="New note in folder">
                                    <span class="bi bi-plus" aria-hidden="true"></span>
                                </button>
                                <button class="folder-delete-btn" 
                                        @onclick="() => PromptDeleteFolder(folder)" 
                                        @onclick:stopPropagation="true"
                                        title="Delete folder">
                                    <span class="bi bi-trash" aria-hidden="true"></span>
                                </button>
                            </div>
                            @if (isFolderExpanded)
                            {
                                <nav class="explorer-items">
                                    @foreach (var note in folderNotes)
                                    {
                                        <div class="note-row @(IsStandardNoteSelected(note, folder) ? "selected" : "")">
                                            <a class="explorer-item note-item folder-note" 
                                               @onclick="() => SelectNoteInFolder(note, folder)" @onclick:preventDefault>
                                                <span class="note-type-indicator @GetNoteTypeClass(note.Type)"></span>
                                                @if (note.Tag != NoteTag.None)
                                                {
                                                    <span class="bi bi-tag-fill note-tag-indicator @GetNoteTagClass(note.Tag)" title="@GetTagDisplayName(note.Tag)" aria-hidden="true"></span>
                                                }
                                                <span class="item-text">@note.Title</span>
                                            </a>
                                            <div class="note-actions">
                                                <button class="note-action-btn note-reveal-btn"
                                                        @onclick="() => RevealNoteInExplorer(note, folder)"
                                                        @onclick:stopPropagation="true"
                                                        title="@GetRevealActionTitle()">
                                                    <span class="bi bi-folder2-open" aria-hidden="true"></span>
                                                </button>
                                                @if (note.IsPinned)
                                                {
                                                    <span class="note-action-btn note-pin-btn pinned" title="Pinned">
                                                        <span class="bi bi-pin-angle-fill" aria-hidden="true"></span>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <button class="note-action-btn note-pin-btn" 
                                                            @onclick="() => TogglePinInFolder(note, folder)" 
                                                            @onclick:stopPropagation="true"
                                                            title="Pin">
                                                        <span class="bi bi-pin-angle" aria-hidden="true"></span>
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }
                                    @if (!folderNotes.Any())
                                    {
                                        <span class="no-items">Empty folder</span>
                                    }
                                </nav>
                            }
                        </div>
                    }

                    @if (!_rootNotes.Any() && !_folders.Any())
                    {
                        <span class="no-items">No notes yet</span>
                    }
                </nav>
            }
        </div>

        @* Trash section *@
        <div class="explorer-section trash-section">
            <div class="section-header" @onclick="ToggleTrashSection">
                <span class="bi @(_trashExpanded ? "bi-chevron-down" : "bi-chevron-right") collapse-icon" aria-hidden="true"></span>
                <span class="bi bi-trash section-icon" aria-hidden="true"></span>
                <span class="section-title">TRASH</span>
                <span class="section-count">@_trashNotes.Count</span>
            </div>
            @if (_trashExpanded)
            {
                <nav class="explorer-items">
                    @foreach (var note in _trashNotes)
                    {
                        <div class="note-row trash-note @(IsStandardNoteSelected(note, TrashFolder) ? "selected" : "")">
                            <a class="explorer-item note-item" 
                               @onclick="() => SelectTrashNote(note)" @onclick:preventDefault>
                                <span class="note-type-indicator @GetNoteTypeClass(note.Type)"></span>
                                @if (note.Tag != NoteTag.None)
                                {
                                    <span class="bi bi-tag-fill note-tag-indicator @GetNoteTagClass(note.Tag)" title="@GetTagDisplayName(note.Tag)" aria-hidden="true"></span>
                                }
                                <span class="item-text">@note.Title</span>
                            </a>
                            <div class="note-actions">
                                <button class="note-action-btn note-reveal-btn"
                                        @onclick="() => RevealNoteInExplorer(note, TrashFolder)"
                                        @onclick:stopPropagation="true"
                                        title="@GetRevealActionTitle()">
                                    <span class="bi bi-folder2-open" aria-hidden="true"></span>
                                </button>
                            </div>
                        </div>
                    }
                    @if (!_trashNotes.Any())
                    {
                        <span class="no-items">Trash is empty</span>
                    }
                </nav>
            }
        </div>
    </div>

    @* Bottom section with settings *@
    <div class="sidebar-footer">
        <NavLink class="footer-item" href="settings">
            <span class="bi bi-gear item-icon" aria-hidden="true"></span>
            <span class="item-text">Settings</span>
        </NavLink>
    </div>
</div>

@* Delete folder confirmation *@
@if (_showDeleteConfirmation)
{
    <div class="delete-overlay" @onclick="CancelDeleteFolder">
        <div class="delete-dialog" @onclick:stopPropagation="true">
            <p>Delete folder "<strong>@_folderToDelete</strong>"?</p>
            <p class="delete-warning">Notes will be moved to trash.</p>
            <div class="delete-actions">
                <button class="btn-cancel" @onclick="CancelDeleteFolder">Cancel</button>
                <button class="btn-delete" @onclick="ConfirmDeleteFolder">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool SidebarCollapsed { get; set; }

    private const string TrashFolder = "Trash";
    
    // Folder state
    private List<string> _allFolders = [];
    private List<string> _folders = [];
    private readonly HashSet<string> _expandedFolders = [];
    private bool _showNewFolderInput;
    private string _newFolderName = string.Empty;
    private bool _showDeleteConfirmation;
    private string? _folderToDelete;

    // Import panel state
    private bool _showImportOptions;
    private bool _isImporting;
    private string _importStatusMessage = string.Empty;
    private bool _importStatusError;
    private string _explorerStatusMessage = string.Empty;
    private bool _explorerStatusError;
    
    // Filter panel state
    private bool _filtersExpanded;
    private bool _searchVisible;
    private bool HasActiveFilters => FilterService.HasActiveFilters;
    private bool HasActiveDropdownFilters =>
        !string.IsNullOrEmpty(FilterService.FilterType) ||
        !string.IsNullOrEmpty(FilterService.FilterTag) ||
        FilterService.SortOption != SortOption.ModifiedNewest;

    private void ToggleFiltersExpanded() => _filtersExpanded = !_filtersExpanded;
    private void ToggleSearchVisible()
    {
        _searchVisible = !_searchVisible;
        if (!_searchVisible)
            _filtersExpanded = false;
    }

    private void ToggleImportOptions()
    {
        _showImportOptions = !_showImportOptions;
        if (_showImportOptions)
            _importStatusMessage = string.Empty;
    }

    // Section expansion state
    private bool _pinnedExpanded = true;
    private bool _rootNotesExpanded = true;
    private bool _trashExpanded;
    
    // Notes cache
    private List<Note> _allRootNotes = [];
    private List<Note> _allPinnedNotes = [];
    private List<Note> _allTrashNotes = [];
    private List<Note> _rootNotes = [];
    private List<Note> _pinnedNotes = [];
    private List<Note> _trashNotes = [];
    private readonly Dictionary<string, List<Note>> _allFolderNotesCache = new();
    private readonly Dictionary<string, List<Note>> _folderNotesCache = new();
    private readonly Dictionary<string, string> _noteFolderMap = new(); // noteTitle -> subfolder

    protected override async Task OnInitializedAsync()
    {
        // If any persisted filter is active, make filter UI visible so hidden filters cannot mask notes.
        _searchVisible = FilterService.HasActiveFilters;
        _filtersExpanded = HasActiveDropdownFilters;

        await LoadAllData();
        SidebarService.OnFoldersChanged += HandleDataChanged;
        SidebarService.OnNotesChanged += HandleDataChanged;
        FilterService.OnFilterChanged += HandleFilterChanged;
    }

    private void ClearAllFilters()
    {
        FilterService.ClearFilters();
    }

    private async Task LoadAllData()
    {
        LoadFolders();
        await LoadAllNotes();
    }

    private void LoadFolders()
    {
        _allFolders = NoteManager.GetSubfolders()
            .Where(f => f != TrashFolder)
            .OrderBy(f => f, StringComparer.OrdinalIgnoreCase)
            .ToList();

        _folders = _allFolders.ToList();
        
        // Auto-expand folders with notes
        foreach (var folder in _allFolders)
        {
            _expandedFolders.Add(folder);
        }
    }

    private async Task LoadAllNotes()
    {
        // Load root notes
        _allRootNotes = (await NoteManager.RetrieveNotesAsync(string.Empty)).ToList();
        
        // Extract pinned notes from all folders
        _allPinnedNotes = _allRootNotes.Where(n => n.IsPinned).ToList();
        
        // Build folder map and load notes for each folder
        _allFolderNotesCache.Clear();
        _folderNotesCache.Clear();
        _noteFolderMap.Clear();
        foreach (var note in _allRootNotes)
            _noteFolderMap[note.Title] = string.Empty;
        
        foreach (var folder in _allFolders)
        {
            var notes = (await NoteManager.RetrieveNotesAsync(folder)).ToList();
            _allFolderNotesCache[folder] = notes;
            
            // Add pinned notes from this folder
            _allPinnedNotes.AddRange(notes.Where(n => n.IsPinned));
            
            foreach (var note in notes)
                _noteFolderMap[note.Title] = folder;
        }
        
        // Load trash notes
        _allTrashNotes = (await NoteManager.RetrieveNotesAsync(TrashFolder)).ToList();

        ApplyFilters();
    }

    private void ApplyFilters()
    {
        _rootNotes = ApplyNoteFilters(_allRootNotes).ToList();
        _pinnedNotes = ApplyNoteFilters(_allPinnedNotes).ToList();
        _trashNotes = ApplyNoteFilters(_allTrashNotes).ToList();

        _folderNotesCache.Clear();
        _folders = [];

        var hasSearchQuery = !string.IsNullOrWhiteSpace(FilterService.SearchQuery);

        foreach (var folder in _allFolders)
        {
            var filteredNotes = ApplyNoteFilters(GetAllNotesForFolder(folder)).ToList();
            var folderMatchesQuery = FolderMatchesQuery(folder);

            // Keep a folder in search results if either its name or its note set matches.
            var includeFolder = !hasSearchQuery || folderMatchesQuery || filteredNotes.Count > 0;

            if (!includeFolder)
                continue;

            _folders.Add(folder);
            _folderNotesCache[folder] = filteredNotes;
        }
    }

    private IEnumerable<Note> ApplyNoteFilters(IEnumerable<Note> notes)
    {
        var filtered = notes;

        if (TryGetSelectedNoteType(out var selectedType))
            filtered = filtered.Where(note => note.Type == selectedType);

        if (!string.IsNullOrWhiteSpace(FilterService.FilterTag)
            && Enum.TryParse<NoteTag>(FilterService.FilterTag, out var selectedTag))
            filtered = filtered.Where(note => note.Tag == selectedTag);

        if (!string.IsNullOrWhiteSpace(FilterService.SearchQuery))
        {
            var query = FilterService.SearchQuery.Trim();
            filtered = filtered.Where(note => NoteMatchesQuery(note, query));
        }

        return SortNotes(filtered);
    }

    private IEnumerable<Note> SortNotes(IEnumerable<Note> notes)
    {
        return FilterService.SortOption switch
        {
            SortOption.ModifiedNewest => notes.OrderByDescending(n => n.ModifiedAt),
            SortOption.ModifiedOldest => notes.OrderBy(n => n.ModifiedAt),
            SortOption.CreatedNewest => notes.OrderByDescending(n => n.CreatedAt),
            SortOption.CreatedOldest => notes.OrderBy(n => n.CreatedAt),
            SortOption.TitleZa => notes.OrderByDescending(n => n.Title, StringComparer.OrdinalIgnoreCase),
            _ => notes.OrderBy(n => n.Title, StringComparer.OrdinalIgnoreCase)
        };
    }

    private bool NoteMatchesQuery(Note note, string query)
    {
        if (string.IsNullOrWhiteSpace(query))
            return true;

        return note.Title.Contains(query, StringComparison.OrdinalIgnoreCase)
            || note.Content.Contains(query, StringComparison.OrdinalIgnoreCase);
    }

    private bool FolderMatchesQuery(string folder)
    {
        if (string.IsNullOrWhiteSpace(FilterService.SearchQuery))
            return true;

        return folder.Contains(FilterService.SearchQuery.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    private bool TryGetSelectedNoteType(out NoteType selectedType)
    {
        selectedType = default;
        return !string.IsNullOrWhiteSpace(FilterService.FilterType)
            && Enum.TryParse(FilterService.FilterType, true, out selectedType);
    }

    private List<Note> GetAllNotesForFolder(string folder)
    {
        return _allFolderNotesCache.TryGetValue(folder, out var notes) ? notes : [];
    }

    private List<Note> GetNotesForFolder(string folder)
    {
        return _folderNotesCache.TryGetValue(folder, out var notes) ? notes : [];
    }

    private void OnSearchChanged(ChangeEventArgs args)
    {
        FilterService.SearchQuery = args.Value?.ToString() ?? string.Empty;
    }

    private void OnTypeFilterChanged(ChangeEventArgs args)
    {
        FilterService.FilterType = args.Value?.ToString() ?? string.Empty;
    }

    private void OnSortOptionChanged(ChangeEventArgs args)
    {
        if (Enum.TryParse<SortOption>(args.Value?.ToString(), out var option))
            FilterService.SortOption = option;
    }


    private void OnTagFilterChanged(NoteTag tag)
    {
        FilterService.FilterTag = FilterService.FilterTag == tag.ToString()
            ? string.Empty
            : tag.ToString();
    }

    private void ClearTagFilter()
    {
        FilterService.FilterTag = string.Empty;
    }

    private void ClearSearch()
    {
        FilterService.SearchQuery = string.Empty;
    }

    private void HandleFilterChanged()
    {
        ApplyFilters();
        InvokeAsync(StateHasChanged);
    }

    private void HandleDataChanged()
    {
        _ = HandleDataChangedAsync();
    }

    private async Task HandleDataChangedAsync()
    {
        try
        {
            await LoadAllData();
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // Prevent background sidebar refresh events from crashing the UI tree.
        }
    }

    private async Task RevealNoteInExplorer(Note note, string folder)
    {
        _explorerStatusMessage = string.Empty;
        _explorerStatusError = false;

        var notePath = await NoteManager.GetNoteFilePathAsync(note.Title, folder);
        if (string.IsNullOrWhiteSpace(notePath))
        {
            _explorerStatusError = true;
            _explorerStatusMessage = "Could not locate this note on disk.";
            return;
        }

        var opened = await FileExplorerService.RevealFileAsync(notePath);
        _explorerStatusError = !opened;
        _explorerStatusMessage = opened
            ? "Opened note location in file explorer."
            : "Could not open the file explorer for this note.";
    }

    private static string GetRevealActionTitle()
    {
        if (OperatingSystem.IsMacCatalyst())
            return "Show in Finder";

        return "Show in file explorer";
    }

    // Section toggles
    private void TogglePinnedSection() => _pinnedExpanded = !_pinnedExpanded;
    private void ToggleRootNotesSection() => _rootNotesExpanded = !_rootNotesExpanded;
    private void ToggleTrashSection() => _trashExpanded = !_trashExpanded;

    private bool AreAllFoldersInNotesSectionCollapsed =>
        _folders.Count > 0 && _folders.All(folder => !_expandedFolders.Contains(folder));

    private void ToggleAllFoldersInNotesSection()
    {
        if (_folders.Count == 0)
            return;

        var shouldExpandAll = _folders.Any(folder => !_expandedFolders.Contains(folder));

        foreach (var folder in _folders)
        {
            if (shouldExpandAll)
                _expandedFolders.Add(folder);
            else
                _expandedFolders.Remove(folder);
        }
    }

    private void CollapseAll()
    {
        _pinnedExpanded = false;
        _rootNotesExpanded = false;
        _trashExpanded = false;
        _expandedFolders.Clear();
    }
    
    private void ToggleFolderExpanded(string folder)
    {
        if (_expandedFolders.Contains(folder))
            _expandedFolders.Remove(folder);
        else
            _expandedFolders.Add(folder);
    }

    // Note selection
    private void SelectNote(Note note)
    {
        SidebarService.SelectNote(note.Title, string.Empty, selectedInPinnedSection: false);
        var encodedTitle = Uri.EscapeDataString(note.Title);
        Navigation.NavigateTo($"/note/view/{encodedTitle}");
    }

    private void SelectPinnedNote(Note note)
    {
        var folder = _noteFolderMap.TryGetValue(note.Title, out var f) ? f : string.Empty;
        SidebarService.SelectNote(note.Title, folder, selectedInPinnedSection: true);
        var encodedTitle = Uri.EscapeDataString(note.Title);
        Navigation.NavigateTo($"/note/view/{encodedTitle}");
    }

    private void SelectNoteInFolder(Note note, string folder)
    {
        SidebarService.SelectNote(note.Title, folder, selectedInPinnedSection: false);
        var encodedTitle = Uri.EscapeDataString(note.Title);
        Navigation.NavigateTo($"/note/view/{encodedTitle}");
    }

    private void SelectTrashNote(Note note)
    {
        SidebarService.SelectNote(note.Title, TrashFolder, selectedInPinnedSection: false);
        var encodedTitle = Uri.EscapeDataString(note.Title);
        Navigation.NavigateTo($"/note/view/{encodedTitle}");
    }

    private bool IsPinnedNoteSelected(Note note)
    {
        if (!SidebarService.SelectedInPinnedSection)
            return false;

        return string.Equals(SidebarService.SelectedNoteTitle, note.Title, StringComparison.Ordinal);
    }

    private bool IsStandardNoteSelected(Note note, string folder)
    {
        if (SidebarService.SelectedInPinnedSection)
            return false;

        return string.Equals(SidebarService.SelectedNoteTitle, note.Title, StringComparison.Ordinal)
            && string.Equals(SidebarService.SelectedNoteFolder, folder, StringComparison.Ordinal);
    }

    // Pin/unpin notes
    private async Task UnpinFromPinnedSection(Note note)
    {
        var folder = _noteFolderMap.TryGetValue(note.Title, out var f) ? f : string.Empty;
        note.IsPinned = false;
        await NoteManager.UpdateNoteAsync(note.Title, note, folder);
        await LoadAllNotes();
        SidebarService.NotifyNotesChanged();
    }

    private async Task TogglePin(Note note)
    {
        note.IsPinned = !note.IsPinned;
        await NoteManager.UpdateNoteAsync(note.Title, note, string.Empty);
        await LoadAllNotes();
        SidebarService.NotifyNotesChanged();
    }

    private async Task TogglePinInFolder(Note note, string folder)
    {
        note.IsPinned = !note.IsPinned;
        await NoteManager.UpdateNoteAsync(note.Title, note, folder);
        await LoadAllNotes();
        SidebarService.NotifyNotesChanged();
    }

    // New note
    private void NavigateToNewNote()
    {
        SidebarService.CurrentFolder = string.Empty;
        Navigation.NavigateTo("/note/new");
    }

    private void NavigateToNewNoteInFolder(string folder)
    {
        SidebarService.CurrentFolder = folder;
        Navigation.NavigateTo("/note/new");
    }

    private async Task ImportFileAsync()
    {
        _isImporting = true;
        _importStatusMessage = string.Empty;
        _importStatusError = false;

        try
        {
            var pickedPath = await FilesPickerService.PickFileAsync();
            if (string.IsNullOrWhiteSpace(pickedPath))
                return;

            var result = await ImportExportService.ImportAsync(pickedPath);
            _importStatusError = !result.Success;
            _importStatusMessage = result.Success
                ? "File imported successfully."
                : result.ErrorMessage ?? "Import failed.";

            if (result.Success)
            {
                await LoadAllData();
                SidebarService.NotifyNotesChanged();
                SidebarService.NotifyFoldersChanged();
            }
        }
        catch (Exception ex)
        {
            _importStatusError = true;
            _importStatusMessage = $"Import failed: {ex.Message}";
        }
        finally
        {
            _isImporting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ImportFolderAsync()
    {
        _isImporting = true;
        _importStatusMessage = string.Empty;
        _importStatusError = false;

        try
        {
            var pickedPath = await FilesPickerService.PickFolderAsync();
            if (string.IsNullOrWhiteSpace(pickedPath))
                return;

            var result = await ImportExportService.ImportAsync(pickedPath);
            _importStatusError = !result.Success;
            _importStatusMessage = result.Success
                ? "Folder imported successfully."
                : result.ErrorMessage ?? "Import failed.";

            if (result.Success)
            {
                await LoadAllData();
                SidebarService.NotifyNotesChanged();
                SidebarService.NotifyFoldersChanged();
            }
        }
        catch (Exception ex)
        {
            _importStatusError = true;
            _importStatusMessage = $"Import failed: {ex.Message}";
        }
        finally
        {
            _isImporting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // Folder operations
    private void ShowNewFolderInput()
    {
        _showNewFolderInput = true;
        _newFolderName = string.Empty;
    }

    private void CancelNewFolder()
    {
        _showNewFolderInput = false;
        _newFolderName = string.Empty;
    }

    private void OnFolderInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            _ = CreateFolderAsync();
        else if (e.Key == "Escape")
            CancelNewFolder();
    }

    private async Task CreateFolderAsync()
    {
        if (!string.IsNullOrWhiteSpace(_newFolderName))
        {
            if (NoteManager.CreateFolder(_newFolderName))
            {
                await LoadAllData();
                SidebarService.NotifyFoldersChanged();
            }
        }
        _showNewFolderInput = false;
        _newFolderName = string.Empty;
    }

    private void PromptDeleteFolder(string folder)
    {
        _folderToDelete = folder;
        _showDeleteConfirmation = true;
    }

    private void CancelDeleteFolder()
    {
        _folderToDelete = null;
        _showDeleteConfirmation = false;
    }

    private async Task ConfirmDeleteFolder()
    {
        if (!string.IsNullOrWhiteSpace(_folderToDelete))
        {
            if (await NoteManager.DeleteFolderAsync(_folderToDelete))
            {
                _expandedFolders.Remove(_folderToDelete);
                await LoadAllData();
                SidebarService.NotifyFoldersChanged();
                // Navigate to home if viewing a note from deleted folder
                Navigation.NavigateTo("/");
            }
        }
        CancelDeleteFolder();
    }

    // Helper methods
    private static string GetNoteTypeClass(NoteType type) => type switch
    {
        NoteType.General => "type-general",
        NoteType.Idea => "type-idea",
        NoteType.Reminder => "type-reminder",
        NoteType.Task => "type-task",
        _ => "type-general"
    };

    private static string GetNoteTagClass(NoteTag tag) => $"tag-{tag.ToString().ToLowerInvariant()}";

    private static string GetTagDisplayName(NoteTag tag) => tag switch
    {
        NoteTag.None => "No Tag",
        NoteTag.Red => "Red",
        NoteTag.Orange => "Orange",
        NoteTag.Yellow => "Yellow",
        NoteTag.Green => "Green",
        NoteTag.Blue => "Blue",
        NoteTag.Purple => "Purple",
        _ => tag.ToString()
    };

    public void Dispose()
    {
        SidebarService.OnFoldersChanged -= HandleDataChanged;
        SidebarService.OnNotesChanged -= HandleDataChanged;
        FilterService.OnFilterChanged -= HandleFilterChanged;
    }
}
