@*
    MainLayout.razor
    Obsidian-style layout with collapsible left sidebar and main content area.

    Structure:
    - Ribbon (leftmost thin bar with core actions)
    - Collapsible sidebar navigation (NavMenu component)
    - Main content area where pages are rendered (@Body)

    Theme Support:
    - The data-theme attribute controls the active color theme
    - Theme changes are reactive via ThemeService subscription
*@
@inherits LayoutComponentBase
@using Noted.Services
@using Microsoft.Maui.Devices
@inject ThemeService ThemeService
@implements IDisposable

<div class="app-scale-shell" style="--app-ui-scale:@ThemeService.UiScale.ToString(System.Globalization.CultureInfo.InvariantCulture);">
<div class="workspace @(SidebarCollapsed ? "sidebar-collapsed" : "") @(IsIosPhone ? "ios-phone" : string.Empty)" data-theme="@ThemeService.CurrentTheme">
    @* Obsidian-style ribbon - thin vertical bar with core actions *@
    <div class="ribbon">
        <div class="ribbon-top">
            <button class="ribbon-btn" @onclick="ToggleSidebar" title="@(SidebarCollapsed ? "Expand sidebar" : "Collapse sidebar")">
                <span class="ribbon-icon">☰</span>
            </button>
        </div>
        <div class="ribbon-center">
            <span class="ribbon-title">Noted</span>
        </div>
        <div class="ribbon-bottom">
            <a class="ribbon-btn" href="settings" title="Settings">
                <span class="ribbon-icon">⚙</span>
            </a>
        </div>
    </div>

    @* Left sidebar with navigation *@
    <div class="sidebar">
        <NavMenu SidebarCollapsed="@SidebarCollapsed" />
    </div>

    <div class="sidebar-backdrop @(SidebarCollapsed ? string.Empty : "visible")" @onclick="CollapseSidebar"></div>

    @* Main content workspace *@
    <main class="workspace-main">
        <div class="workspace-content">
            @Body
        </div>
    </main>
</div>
</div>

@code {
    // Sidebar starts expanded for Obsidian-like experience
    private bool SidebarCollapsed { get; set; }
    private bool IsIosPhone { get; set; }

    protected override void OnInitialized()
    {
        IsIosPhone = DeviceInfo.Current.Platform == DevicePlatform.iOS && DeviceInfo.Current.Idiom == DeviceIdiom.Phone;

        if (IsIosPhone)
        {
            SidebarCollapsed = true;
        }

        // Subscribe to theme changes to trigger UI update
        ThemeService.OnThemeChanged += HandleThemeChanged;
    }

    private void ToggleSidebar()
    {
        SidebarCollapsed = !SidebarCollapsed;
    }

    private void CollapseSidebar()
    {
        SidebarCollapsed = true;
    }

    private void HandleThemeChanged()
    {
        // Invoke on UI thread to ensure proper rendering
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        // Unsubscribe to prevent memory leaks
        ThemeService.OnThemeChanged -= HandleThemeChanged;
    }
}
