@*
    MainLayout.razor
    The root layout component that wraps all page content.
    
    Structure:
    - Collapsible sidebar navigation (NavMenu component)
    - Main content area where pages are rendered (@Body)
    
    Theme Support:
    - The data-theme attribute controls the active color theme
    - Theme changes are reactive via ThemeService subscription
    
    To modify the layout:
    - Adjust the sidebar width in MainLayout.razor.css
    - Modify theme colors in the app's main CSS file
*@
@inherits LayoutComponentBase
@using Noted.Services
@inject ThemeService ThemeService
@implements IDisposable

<div class="page @(SidebarCollapsed ? "sidebar-collapsed" : "")" data-theme="@ThemeService.CurrentTheme">
    <div class="sidebar">
        <NavMenu SidebarCollapsed="@SidebarCollapsed" />
        <button class="sidebar-toggle" @onclick="ToggleSidebar" title="@(SidebarCollapsed ? "Expand sidebar" : "Collapse sidebar")">
            <span class="toggle-icon">@(SidebarCollapsed ? "›" : "‹")</span>
        </button>
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    // Sidebar starts collapsed by default for more content space
    private bool SidebarCollapsed { get; set; } = true;

    protected override void OnInitialized()
    {
        // Subscribe to theme changes to trigger UI update
        ThemeService.OnThemeChanged += HandleThemeChanged;
    }

    private void ToggleSidebar()
    {
        SidebarCollapsed = !SidebarCollapsed;
    }

    private void HandleThemeChanged()
    {
        // Invoke on UI thread to ensure proper rendering
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        // Unsubscribe to prevent memory leaks
        ThemeService.OnThemeChanged -= HandleThemeChanged;
    }
}
